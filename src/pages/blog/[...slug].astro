---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} - Simon Lowes`;
const description = post.data.description || `Blog post by Simon Lowes: ${post.data.title}`;
const publishDate = post.data.date.toISOString();
const url = `https://simonlowes.com/blog/${post.slug}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="Simon Lowes" />
    <meta property="article:published_time" content={publishDate} />
    <meta property="article:author" content="Simon Lowes" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={post.data.title} />
    <meta name="twitter:description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href={url} />

    <link rel="stylesheet" type="text/css" href="/css/style.css" />
    <link rel="icon" href="/favicons/fav32.ico" type="image/x-icon" sizes="32x32" />

    <!-- Structured Data for Blog Post -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: post.data.title,
        description: description,
        datePublished: publishDate,
        author: {
          "@type": "Person",
          name: "Simon Lowes",
          url: "https://simonlowes.com",
        },
        publisher: {
          "@type": "Person",
          name: "Simon Lowes",
        },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": url,
        },
      })}
    />

    <style>
      .blog-post {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        background: var(--color-bg-primary, #000);
        color: var(--color-text-primary, #fff);
        font-family: "freight-sans-pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
      }

      .blog-post__header {
        padding: 2rem var(--h-inset, 2rem);
        border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
      }

      .blog-post__back {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--color-text-secondary, rgba(255, 255, 255, 0.85));
        text-decoration: none;
        font-size: 0.95rem;
      }

      .blog-post__back:hover {
        text-decoration: underline;
      }

      .blog-post__title {
        margin: 0;
        font-size: clamp(1.75rem, 5vw, 2.5rem);
        font-weight: 700;
        line-height: 1.2;
      }

      .blog-post__meta {
        margin: 0.75rem 0 0;
        font-size: 0.95rem;
        opacity: 0.75;
      }

      .blog-post__content {
        flex: 1;
        padding: 2rem var(--h-inset, 2rem);
        max-width: 700px;
        width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
      }

      /* Prose styles for rendered MDX/Markdown */
      .blog-post__content :global(h1),
      .blog-post__content :global(h2),
      .blog-post__content :global(h3),
      .blog-post__content :global(h4) {
        margin: 2rem 0 1rem;
        line-height: 1.3;
      }

      .blog-post__content :global(h2) {
        font-size: 1.5rem;
      }

      .blog-post__content :global(h3) {
        font-size: 1.25rem;
      }

      .blog-post__content :global(p) {
        margin: 1rem 0;
        line-height: 1.7;
      }

      .blog-post__content :global(a) {
        color: var(--color-text-primary, #fff);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      .blog-post__content :global(a:hover) {
        opacity: 0.8;
      }

      .blog-post__content :global(ul),
      .blog-post__content :global(ol) {
        margin: 1rem 0;
        padding-left: 1.5rem;
      }

      .blog-post__content :global(li) {
        margin: 0.5rem 0;
        line-height: 1.6;
      }

      .blog-post__content :global(blockquote) {
        margin: 1.5rem 0;
        padding: 1rem 1.5rem;
        border-left: 3px solid var(--color-border, rgba(255, 255, 255, 0.2));
        background: var(--color-bg-secondary, rgba(15, 15, 15, 0.4));
        border-radius: 0 8px 8px 0;
        font-style: italic;
      }

      .blog-post__content :global(code) {
        background: var(--color-bg-secondary, rgba(15, 15, 15, 0.6));
        padding: 0.2em 0.4em;
        border-radius: 4px;
        font-size: 0.9em;
        font-family: "SF Mono", Monaco, Consolas, monospace;
      }

      .blog-post__content :global(pre) {
        margin: 1.5rem 0;
        padding: 1rem;
        background: var(--color-bg-secondary, rgba(15, 15, 15, 0.6));
        border-radius: 8px;
        overflow-x: auto;
      }

      .blog-post__content :global(pre code) {
        background: none;
        padding: 0;
      }

      .blog-post__content :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 1.5rem 0;
      }

      .blog-post__content :global(hr) {
        margin: 2rem 0;
        border: none;
        border-top: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
      }

      .blog-post__footer {
        padding: 2rem var(--h-inset, 2rem);
        border-top: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
        max-width: 700px;
        width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
      }

      .blog-post__nav {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
      }

      .blog-post__nav a {
        color: var(--color-text-secondary, rgba(255, 255, 255, 0.85));
        text-decoration: none;
      }

      .blog-post__nav a:hover {
        text-decoration: underline;
      }

      @media (max-width: 600px) {
        .blog-post__header,
        .blog-post__content,
        .blog-post__footer {
          padding-left: 1rem;
          padding-right: 1rem;
        }
      }
    </style>
  </head>
  <body class="blog-post">
    <header class="blog-post__header">
      <a href="/blog/" class="blog-post__back">&larr; All posts</a>
      <h1 class="blog-post__title">{post.data.title}</h1>
      <p class="blog-post__meta">
        <time datetime={publishDate}>
          {
            post.data.date.toLocaleDateString("en-GB", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
      </p>
    </header>

    <main class="blog-post__content">
      <Content />
    </main>

    <footer class="blog-post__footer">
      <nav class="blog-post__nav" aria-label="Blog navigation">
        <a href="/blog/">&larr; All posts</a>
        <a href="/">Home</a>
      </nav>
    </footer>
  </body>
</html>
