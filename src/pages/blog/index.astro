---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = "Blog - Simon Lowes";
const description = "Updates, notes, and thoughts from Simon Lowes.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://simonlowes.com/blog/" />
    <meta property="og:site_name" content="Simon Lowes" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="stylesheet" type="text/css" href="/css/style.css" />
    <link rel="icon" href="/favicons/fav32.ico" type="image/x-icon" sizes="32x32" />

    <style>
      .blog-page {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        background: var(--color-bg-primary, #000);
        color: var(--color-text-primary, #fff);
        font-family: "freight-sans-pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
      }

      .blog-page__header {
        padding: 2rem var(--h-inset, 2rem);
        border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
      }

      .blog-page__title {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
      }

      .blog-page__subtitle {
        margin: 0.5rem 0 0;
        opacity: 0.85;
        font-size: 1.1rem;
      }

      .blog-page__back {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--color-text-secondary, rgba(255, 255, 255, 0.85));
        text-decoration: none;
        font-size: 0.95rem;
      }

      .blog-page__back:hover {
        text-decoration: underline;
      }

      .blog-page__content {
        flex: 1;
        padding: 2rem var(--h-inset, 2rem);
        max-width: 800px;
        width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
      }

      .blog-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 1.5rem;
      }

      .blog-list__item {
        padding: 1.5rem;
        background: var(--color-bg-secondary, rgba(15, 15, 15, 0.4));
        border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
        border-radius: 12px;
        transition: background 0.2s ease;
      }

      .blog-list__item:hover {
        background: var(--color-interactive-bg, rgba(255, 255, 255, 0.15));
      }

      .blog-list__link {
        color: inherit;
        text-decoration: none;
        display: block;
      }

      .blog-list__title {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 600;
      }

      .blog-list__meta {
        margin: 0.5rem 0 0;
        font-size: 0.9rem;
        opacity: 0.75;
      }

      .blog-list__description {
        margin: 0.75rem 0 0;
        line-height: 1.5;
        opacity: 0.9;
      }

      .blog-page__empty {
        text-align: center;
        padding: 3rem 1rem;
        opacity: 0.7;
      }

      @media (max-width: 600px) {
        .blog-page__header,
        .blog-page__content {
          padding-left: 1rem;
          padding-right: 1rem;
        }

        .blog-list__item {
          padding: 1rem;
        }
      }
    </style>
  </head>
  <body class="blog-page">
    <header class="blog-page__header">
      <a href="/" class="blog-page__back">&larr; Back to home</a>
      <h1 class="blog-page__title">Blog</h1>
      <p class="blog-page__subtitle">Updates, notes, and thoughts.</p>
    </header>

    <main class="blog-page__content">
      {
        posts.length > 0 ? (
          <ul class="blog-list">
            {posts.map((post) => (
              <li class="blog-list__item">
                <a href={`/blog/${post.slug}/`} class="blog-list__link">
                  <h2 class="blog-list__title">{post.data.title}</h2>
                  <p class="blog-list__meta">
                    <time datetime={post.data.date.toISOString()}>
                      {post.data.date.toLocaleDateString("en-GB", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                  </p>
                  {post.data.description && (
                    <p class="blog-list__description">{post.data.description}</p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="blog-page__empty">No posts yet — check back soon.</p>
        )
      }
    </main>
  </body>
</html>
