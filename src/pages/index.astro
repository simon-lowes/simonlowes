---
import { getCollection } from "astro:content";
import { ViewTransitions } from "astro:transitions";
import SpaceBackground from "../components/SpaceBackground.astro";
import "../styles/glass-effects.css";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="stylesheet" type="text/css" href="/css/style.css" />
    <link rel="icon" href="/favicons/fav16.ico" type="image/x-icon" sizes="16x16" />
    <link rel="icon" href="/favicons/fav32.ico" type="image/x-icon" sizes="32x32" />
    <link rel="icon" href="/favicons/fav64.ico" type="image/x-icon" sizes="64x64" />
    <link rel="icon" href="/favicons/fav128.ico" type="image/x-icon" sizes="128x128" />
    <link rel="icon" href="/favicons/fav256.ico" type="image/x-icon" sizes="256x256" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Simon Lowes",
        "url": "https://simonlowes.com",
        "sameAs": [
          "https://www.instagram.com/simonlowesmusic/",
          "https://open.spotify.com/artist/1E8slBJPNvUSPpRIh3xtkI?si=LOjXYVnQRhiZU6XmjkUdhg&nd=1",
          "https://music.apple.com/gb/artist/simon-lowes/1351008298",
          "https://music.youtube.com/channel/UCI4xshiWQrOu_27TPmW9A2g",
          "https://soundcloud.com/simonlowesmusic",
          "https://www.youtube.com/simonlowesmusic"
        ]
      }
    </script>

    <title>Simon Lowes - Musician</title>
    <meta
      name="description"
      content="Simon Lowes - Discover and listen to the music of Simon Lowes on various platforms such as Spotify, Apple Music, YouTube Music, and SoundCloud. Follow Simon on social media platforms like YouTube and Instagram."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- Open Graph -->
    <meta property="og:title" content="Simon Lowes - Musician" />
    <meta
      property="og:description"
      content="Discover and listen to the music of Simon Lowes on various platforms such as Spotify, Apple Music, YouTube Music, and SoundCloud."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://simonlowes.com/" />
    <meta property="og:site_name" content="Simon Lowes" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Simon Lowes - Musician" />
    <meta
      name="twitter:description"
      content="Discover and listen to the music of Simon Lowes on Spotify, Apple Music, YouTube Music, and SoundCloud."
    />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://simonlowes.com/" />

    <!-- PWA -->
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />

    <!-- View Transitions for seamless navigation -->
    <ViewTransitions />

    <meta name="google-site-verification" content="gwurdptI6ejhc1SisVjfxFNaGX2lU19i646cuMxbK20" />
    <meta name="robots" content="index, follow" />
    <style>
      /* Skip-link styles now in global CSS (public/css/style.css) */

      /* Cookie notice - minimal bottom-left banner per web standards */
      #cookie-message {
        position: fixed;
        bottom: 1rem;
        left: 1rem;
        max-width: 280px;
        background: rgba(20, 20, 30, 0.92);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
        font-family: "freight-sans-pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 0.8125rem;
        line-height: 1.4;
        z-index: 999;
      }
      #cookie-message[hidden] {
        display: none;
      }
      #cookie-message p {
        margin: 0 0 0.5rem;
      }
      #cookie-message .cookie-icon {
        display: inline-block;
        width: 1em;
        height: 1em;
        vertical-align: -0.1em;
        margin-right: 0.4em;
        opacity: 0.75;
      }
      #cookie-message .cookie-actions {
        display: flex;
        justify-content: flex-end;
      }
      #cookie-message button.cookie-dismiss {
        padding: 0.375rem 0.75rem;
        font-size: 0.75rem;
        background: rgba(0, 212, 255, 0.12);
        border: 1px solid rgba(0, 212, 255, 0.25);
        border-radius: 4px;
        color: #00d4ff;
        cursor: pointer;
        transition: background 0.15s ease;
      }
      #cookie-message button.cookie-dismiss:hover {
        background: rgba(0, 212, 255, 0.22);
      }
      #cookie-message button.cookie-dismiss:focus-visible {
        outline: 2px solid rgba(0, 212, 255, 0.5);
        outline-offset: 2px;
      }
      @media (max-width: 480px) {
        #cookie-message {
          left: 0.75rem;
          right: 0.75rem;
          bottom: 0.75rem;
          max-width: none;
        }
      }
      /* Content wrapper with glass panel styling */
      .content-wrapper {
        position: fixed;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding-top: calc(
          var(--edge-gap) + var(--player-h) + var(--edge-gap) + env(safe-area-inset-top)
        );
        padding-bottom: calc(
          var(--edge-gap) + var(--footer-h) + var(--edge-gap) + env(safe-area-inset-bottom)
        );
        /* No horizontal padding - blog-panel handles its own width */
        padding-left: 0;
        padding-right: 0;
        box-sizing: border-box;
        overflow: hidden;
      }
      /* Blog panel with glass effect - matches audio player and footer width */
      .blog-panel {
        position: relative;
        z-index: 2;
        /* Unified width system - matches audio player and footer */
        width: calc((100% - var(--h-inset)) * var(--content-w));
        max-width: calc((1200px - var(--h-inset)) * var(--content-w));
        height: 100%;
        box-sizing: border-box;
        margin: 0;
        padding: 1.5rem 2rem 2rem;
        border-radius: 20px;
        background: rgba(10, 10, 15, 0.18);
        border: 1px solid rgba(0, 212, 255, 0.1);
        box-shadow:
          0 16px 48px rgba(0, 0, 0, 0.5),
          0 0 60px rgba(0, 212, 255, 0.03),
          inset 0 1px 0 rgba(255, 255, 255, 0.03);
        color: #e0e0e0;
        overflow-y: auto;
      }
      .blog-panel__header {
        margin-bottom: 0.75rem;
      }
      .blog-panel__title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 650;
        letter-spacing: 0.01em;
        color: #e0e0e0;
        text-shadow: 0 0 30px rgba(0, 212, 255, 0.3);
      }
      .blog-panel__subtitle {
        margin: 0.25rem 0 0;
        opacity: 0.75;
        line-height: 1.4;
      }
      .blog-panel__content p {
        margin: 0.75rem 0 0;
        line-height: 1.5;
      }
      .blog-panel a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        transition:
          color 0.2s ease,
          text-shadow 0.2s ease;
      }
      .blog-panel a:hover {
        color: #00d4ff;
        text-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
      }
      .blog-panel__list {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0 0;
        display: grid;
        gap: 0.6rem;
      }
      .blog-panel__item {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        transition:
          background 0.2s ease,
          border-color 0.2s ease;
        border: 1px solid transparent;
      }
      .blog-panel__item:hover {
        background: rgba(0, 212, 255, 0.05);
        border-color: rgba(0, 212, 255, 0.1);
      }
      @media (max-width: 600px) {
        .content-wrapper {
          /* No container padding - blog-panel width formula handles margins */
          padding-left: 0;
          padding-right: 0;
        }
        .blog-panel {
          /* Keep using unified width formula - it handles margins via --h-inset */
          padding: 1.25rem 1.25rem 1.5rem;
          border-radius: 16px;
        }
        .blog-panel__item {
          justify-content: flex-start;
          gap: 0.35rem 0.75rem;
        }
        .blog-panel__date {
          width: 100%;
          font-size: 0.85rem;
        }
      }
      .blog-panel__date {
        opacity: 0.6;
        white-space: nowrap;
        font-size: 0.9rem;
      }
      .blog-panel__more {
        margin-top: 0.9rem;
      }
      /* Footer - no box, icons float freely */
      footer {
        background: transparent !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        border: none !important;
        box-shadow: none !important;
      }
      footer nav ul li a {
        transition: transform 0.15s ease !important;
      }
      footer nav ul li a:hover {
        transform: scale(1.1);
      }
      footer nav ul li a .social-icon {
        transition:
          color 0.3s ease,
          filter 0.3s ease;
      }
      /* Brand colors on hover - official hex colors */
      /* Bandcamp: #629aa9 (teal) */
      footer nav ul li a[data-social="bandcamp"]:hover {
        color: #629aa9;
      }
      footer nav ul li a[data-social="bandcamp"]:hover .social-icon {
        filter: drop-shadow(0 0 8px #629aa9);
      }
      /* Spotify: #1DB954 (green) */
      footer nav ul li a[data-social="spotify"]:hover {
        color: #1db954;
      }
      footer nav ul li a[data-social="spotify"]:hover .social-icon {
        filter: drop-shadow(0 0 8px #1db954);
      }
      /* Apple Music: #FA57C1 (pink) */
      footer nav ul li a[data-social="apple-music"]:hover {
        color: #fa57c1;
      }
      footer nav ul li a[data-social="apple-music"]:hover .social-icon {
        filter: drop-shadow(0 0 8px #fa57c1);
      }
      /* YouTube Music: #FF0000 (red) */
      footer nav ul li a[data-social="youtube-music"]:hover {
        color: #ff0000;
      }
      footer nav ul li a[data-social="youtube-music"]:hover .social-icon {
        filter: drop-shadow(0 0 8px #ff0000);
      }
      /* YouTube: #FF0000 (red) */
      footer nav ul li a[data-social="youtube"]:hover {
        color: #ff0000;
      }
      footer nav ul li a[data-social="youtube"]:hover .social-icon {
        filter: drop-shadow(0 0 8px #ff0000);
      }
      /* Instagram: #E4405F (gradient pink - using primary) */
      footer nav ul li a[data-social="instagram"]:hover {
        color: #e4405f;
      }
      footer nav ul li a[data-social="instagram"]:hover .social-icon {
        filter: drop-shadow(0 0 8px #e4405f);
      }
      /* Enhanced audio player glass styling */
      .audio-player {
        background: rgba(10, 10, 15, 0.18) !important;
        border: 1px solid rgba(0, 212, 255, 0.1) !important;
        box-shadow:
          0 8px 32px rgba(0, 0, 0, 0.4),
          0 0 40px rgba(0, 212, 255, 0.03) !important;
      }
      .audio-player__play {
        background: rgba(0, 212, 255, 0.15) !important;
        border: 1px solid rgba(0, 212, 255, 0.2);
        transition:
          background 0.2s ease,
          transform 0.15s ease,
          box-shadow 0.3s ease !important;
      }
      .audio-player__play:hover {
        background: rgba(0, 212, 255, 0.25) !important;
        box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
      }
      .audio-player__seek::-webkit-slider-thumb {
        background: #00d4ff !important;
        box-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
      }
      .audio-player__seek::-moz-range-thumb {
        background: #00d4ff !important;
        box-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
      }
      .audio-player__volume-slider::-webkit-slider-thumb {
        background: #00d4ff !important;
      }
      .audio-player__volume-slider::-moz-range-thumb {
        background: #00d4ff !important;
      }
      /* Reduced motion support */
      @media (prefers-reduced-motion: reduce) {
        .blog-panel__item,
        footer nav ul li a,
        .audio-player__play {
          transition: none !important;
        }
        .blog-panel__item:hover,
        footer nav ul li a:hover {
          transform: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <!-- Three.js Space Background -->
    <SpaceBackground />
    <main class="content-wrapper" id="main-content">
      <section id="blog-slot" class="blog-panel" aria-label="Blog">
        <header class="blog-panel__header">
          <h2 class="blog-panel__title">Blog</h2>
          <p class="blog-panel__subtitle">Latest updates and notes.</p>
        </header>

        <div class="blog-panel__content">
          {
            posts.length ? (
              <ul class="blog-panel__list">
                {posts.map((p) => (
                  <li class="blog-panel__item">
                    <a href={`/blog/${p.slug}/`}>{p.data.title}</a>
                    <small class="blog-panel__date">{p.data.date.toISOString().slice(0, 10)}</small>
                  </li>
                ))}
              </ul>
            ) : (
              <p>No posts yet — check back soon.</p>
            )
          }

          <p class="blog-panel__more">
            <a href="/blog/">All posts &rarr;</a>
          </p>
        </div>
      </section>
    </main>
    <!-- Audio Player Component -->
    <div
      class="audio-player"
      id="audio-player"
      role="region"
      aria-label="Audio player for Never There"
    >
      <audio id="myAudio" src="/neverthere.mp3" preload="metadata"></audio>

      <!-- Play/Pause Button -->
      <button
        type="button"
        class="audio-player__play"
        id="audio-play-btn"
        aria-label="Play Never There"
        aria-pressed="false"
      >
        <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z"></path>
        </svg>
        <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
        </svg>
      </button>

      <!-- Time Display (Elapsed) -->
      <span
        class="audio-player__time audio-player__time--elapsed"
        id="audio-time-elapsed"
        aria-live="off">0:00</span
      >

      <!-- Seek Slider -->
      <input
        type="range"
        class="audio-player__seek"
        id="audio-seek"
        min="0"
        max="100"
        value="0"
        step="0.1"
        aria-label="Seek slider"
      />

      <!-- Time Display (Remaining) -->
      <span
        class="audio-player__time audio-player__time--remaining"
        id="audio-time-remaining"
        aria-live="off">-0:00</span
      >

      <!-- Volume Controls -->
      <div class="audio-player__volume">
        <button
          type="button"
          class="audio-player__mute"
          id="audio-mute-btn"
          aria-label="Mute audio"
          aria-pressed="false"
        >
          <svg class="icon-volume" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
            ></path>
          </svg>
          <svg class="icon-muted" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
            ></path>
          </svg>
        </button>
        <input
          type="range"
          class="audio-player__volume-slider"
          id="audio-volume"
          min="0"
          max="100"
          value="75"
          step="1"
          aria-label="Volume slider"
        />
      </div>
    </div>
    <div
      id="cookie-message"
      role="status"
      aria-live="polite"
      aria-label="Cookie notice"
      tabindex="-1"
    >
      <p>
        <svg class="cookie-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5"
          ></circle><circle cx="8" cy="9" r="1.5"></circle><circle cx="15" cy="8" r="1.2"
          ></circle><circle cx="10" cy="14" r="1.3"></circle><circle cx="16" cy="14" r="1"
          ></circle></svg
        >This site doesn't use cookies or trackers.
      </p>
      <div class="cookie-actions">
        <button type="button" class="cookie-dismiss" aria-label="Dismiss" data-cookie-dismiss
          >Got it</button
        >
      </div>
    </div>

    <footer role="contentinfo">
      <nav aria-label="Social media and music platforms">
        <ul>
          <li>
            <a
              href="https://simonlowes.bandcamp.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit Simon Lowes on BandCamp (opens in new tab)"
              data-social="bandcamp"
              ><svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><path d="M0 18.75l7.437-13.5H24l-7.438 13.5z"></path></svg
              ></a
            >
          </li>
          <li>
            <a
              href="https://open.spotify.com/artist/1E8slBJPNvUSPpRIh3xtkI?si=LOjXYVnQRhiZU6XmjkUdhg"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Listen to Simon Lowes on Spotify (opens in new tab)"
              data-social="spotify"
              ><svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><path
                  d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"
                ></path></svg
              ></a
            >
          </li>
          <li>
            <a
              href="https://music.apple.com/gb/artist/simon-lowes/1351008298"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Listen to Simon Lowes on Apple Music (opens in new tab)"
              data-social="apple-music"
              ><svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><path
                  d="M23.994 6.124a9.23 9.23 0 00-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043A5.022 5.022 0 0019.7.165C18.966.053 18.226.012 17.487 0H6.514C5.774.012 5.034.053 4.3.165a5.022 5.022 0 00-1.875.686C1.307 1.525.562 2.525.245 3.835a9.23 9.23 0 00-.24 2.19L0 6.197v11.606l.005.073a9.23 9.23 0 00.24 2.19c.317 1.31 1.062 2.31 2.18 3.043a5.022 5.022 0 001.875.685c.734.113 1.474.153 2.214.165h10.972c.74-.012 1.48-.052 2.214-.165a5.022 5.022 0 001.875-.685c1.118-.733 1.863-1.733 2.18-3.043a9.23 9.23 0 00.24-2.19l.005-.073V6.197l-.005-.073zM16.948 17.5a.573.573 0 01-.565.55c-.01 0-.02 0-.03 0h-.01a.563.563 0 01-.08-.005l-.01-.001h-.004a.573.573 0 01-.48-.54V11.84a.573.573 0 00-.59-.553H9.37a.573.573 0 00-.555.59v5.12a.573.573 0 01-.57.555h-.01a.573.573 0 01-.57-.555V7.91a.573.573 0 01.555-.59h.025c.01 0 .02 0 .03.001l.01.001h.004a.573.573 0 01.48.54v4.46a.573.573 0 00.59.553h5.81a.573.573 0 00.555-.59V7.03a.573.573 0 01.57-.555h.01a.573.573 0 01.565.555V17.5z"
                ></path></svg
              ></a
            >
          </li>
          <li>
            <a
              href="https://music.youtube.com/channel/UCI4xshiWQrOu_27TPmW9A2g?feature=share"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Listen to Simon Lowes on YouTube Music (opens in new tab)"
              data-social="youtube-music"
              ><svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><path
                  d="M12 0C5.376 0 0 5.376 0 12s5.376 12 12 12 12-5.376 12-12S18.624 0 12 0zm0 19.104c-3.924 0-7.104-3.18-7.104-7.104S8.076 4.896 12 4.896s7.104 3.18 7.104 7.104-3.18 7.104-7.104 7.104zm0-13.332c-3.432 0-6.228 2.796-6.228 6.228S8.568 18.228 12 18.228 18.228 15.432 18.228 12 15.432 5.772 12 5.772zM9.684 15.54V8.46L15.816 12l-6.132 3.54z"
                ></path></svg
              ></a
            >
          </li>
          <li>
            <a
              href="https://www.youtube.com/simonlowesmusic"
              target="_blank"
              rel="noopener noreferrer"
