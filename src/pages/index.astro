---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import SpaceBackground from "../components/SpaceBackground.astro";
import BandcampPlayer from "../components/BandcampPlayer.astro";
import SocialLinks from "../components/SocialLinks.astro";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="stylesheet" type="text/css" href="/css/style.css" />
    <link rel="icon" href="/favicons/fav16.ico" type="image/x-icon" sizes="16x16" />
    <link rel="icon" href="/favicons/fav32.ico" type="image/x-icon" sizes="32x32" />
    <link rel="icon" href="/favicons/fav64.ico" type="image/x-icon" sizes="64x64" />
    <link rel="icon" href="/favicons/fav128.ico" type="image/x-icon" sizes="128x128" />
    <link rel="icon" href="/favicons/fav256.ico" type="image/x-icon" sizes="256x256" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Simon Lowes",
        "url": "https://www.simonlowes.com",
        "sameAs": [
          "https://www.instagram.com/simonlowesmusic/",
          "https://open.spotify.com/artist/1E8slBJPNvUSPpRIh3xtkI?si=LOjXYVnQRhiZU6XmjkUdhg&nd=1",
          "https://music.apple.com/gb/artist/simon-lowes/1351008298",
          "https://music.youtube.com/channel/UCI4xshiWQrOu_27TPmW9A2g",
          "https://www.youtube.com/simonlowesmusic"
        ]
      }
    </script>
    <title>Simon Lowes - Musician</title>
    <meta
      name="description"
      content="Simon Lowes - Discover and listen to the music of Simon Lowes on various platforms such as Spotify, Apple Music, and YouTube Music. Follow Simon on social media platforms like YouTube and Instagram."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- Open Graph -->
    <meta property="og:title" content="Simon Lowes - Musician" />
    <meta
      property="og:description"
      content="Discover and listen to the music of Simon Lowes on various platforms such as Spotify, Apple Music, and YouTube Music."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://simonlowes.com/" />
    <meta property="og:site_name" content="Simon Lowes" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Simon Lowes - Musician" />
    <meta
      name="twitter:description"
      content="Discover and listen to the music of Simon Lowes on Spotify, Apple Music, and YouTube Music."
    />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://simonlowes.com/" />

    <!-- PWA -->
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />

    <!-- View Transitions for seamless navigation -->
    <ClientRouter />

    <meta name="google-site-verification" content="gwurdptI6ejhc1SisVjfxFNaGX2lU19i646cuMxbK20" />
    <meta
      name="keywords"
      content="Simon Lowes, Musician, Performer, Tours, Music, Lowes, Simon, Song, Songwriter, Writer, Guitar, Guitarist, Synthesizer, Drums, Alternative, Rock, Rock and Roll, Alternative Rock Musician, Rock Artist, Artist, Alternative Music, Singer-songwriter, Band, Indie rock, Alternative sound, Music producer, Production, Melodic Rock, Moderate Rock, Singer, Vocalist, Song composition, Alternative Genre, Slowburn, Slowburner, Live performance, Live Music, Live, Studio Recording, Saltwell Studio, Chris Pepper, Rob Baldock, re:liverecordings, Music Industry, Alternative Rock Band, Alt Rock, Creative Expression, Alternative Pop, Pop, Pop Music, Solo, Lyrics, SoundCloud, Apple Music, Spotify, BandCamp, YouTube-Music, Deezer, Amazon Music, Pandora, Tidal, iHeartRadio, Napster, JioSaavn, Gaana, Tencent Music, Anghami, Yandex Music, QQ Music, KKBOX, Wynk Music, Boomplay, YouTube, Genre-bending, Music Streaming, Streaming, Simon Lowe, Simon Low, Lowes Simon, Lowe Simon, Low Simon, Simon Lowes Musician, Simon Lowe Musician, Simon Low Musician, Lowes Simon Musician, Lowe Simon Musician, Low Simon Musician, Simon Lowes Music, Simon Lowe Music, Simon Low Music, Lowes Simon Music, Lowe Simon Music, Low Simon Music, Lowes Simon Music, Lowe Simon Music, Low Simon Music, Simon Lowes Singer, Simon Lowe Singer, Simon Low Singer, Lowes Simon Singer, Lowe Simon Singer, Simon Lowes Songwriter, Simon Lowe Songwriter, Simon Low Songwriter, Lowes Simon Songwriter, Lowe Simon Songwriter, Low Simon Songwriter, Simon Lowes Artist, Simon Lowe Artist, Simon Low Artist, Lowes Simon Artist, Lowe Simon Artist, Low Simon Artist, Simom Lowes Songs, Simon Lowe Songs, Simon Low Songs, Simon Lowes Band, Simon Lowe Band, Simon Low Band, Band Simon Lowes, Band Simon Lowe, Band Simon Low, Lowes Simon Band, Lowe Simon Band, Low Simon Band, Simon Lowes Ablums, Simon Lowe Albums, Simon Low Albums, Lowes Simon Albums, Lowe Simon Albums, Low Simon Albums, Simon Lowes Singles, Simon Lowe Singles, Simon Low Singles, Lowes Simon Singles, Lowe Simon Singles, Low Simon Singles, Simon Lowes Discography, Simon Lowe Discography, Simon Low Discography, Lowes Simon Discography, Lowe Simon Discography, Low Simon Discography, Simon Lowes Musical Artist, Simon Lowe Musical Artist, Simon Low Musical Artist, Lowes Simon Musical Artist, Lowe Simon Musical Artist, Low Simon Musical Artist, Simon Lowes Biography, Simon Lowe Biography, Simon Low Biography, Lowes Simon Biography, Lowe Simon Biography, Low Simon Biography, Simon Lowes Official Website, Simon Lowe Official Website, Simon Low Official Website, Lowes Simon Official Website, Lowe Simon Official Website, Low Simon Offical Website, Blues, Punk Rock, Acoustic Guitar, Electric Guitar, Fender, Gibson, Les Paul, Telecaster, Martin Guitar, Gibson Guitar, Fender Guitar, Fender Telecaster, Riffs, Instagram, Facebook, Tumblr, Twitter, TikTok, YouTube, Imitate Song, Slowburner Album, Time Song, Stolen Moment Song, Nobody Else Song, False Light Song, Mother Earth Song, For As Long As It Can Be Song, Here Right Now Song, Turn Me Off Song, Eternity Song, When It Falls Song, Air Song, Nobody Song, Slow Motion Song, Simon Loe, Simon Loes, Simon Loze"
    />
    <meta name="robots" content="index, follow" />
    <style>
      /* Skip-link styles now in global CSS (public/css/style.css) */

      /* Cookie notice: a small glass card, bottom-left, same language as the player bar */
      #cookie-message {
        position: fixed;
        /* Above the footer's social links at every width; --footer-h is measured by JS */
        bottom: calc(var(--edge-gap) * 2 + var(--footer-h, 60px) + env(safe-area-inset-bottom));
        left: calc(var(--edge-gap) + env(safe-area-inset-left));
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        max-width: 22rem;
        padding: 0.875rem 1rem;
        background: rgb(var(--color-surface-rgb) / 55%);
        border: 1px solid rgb(var(--color-accent-rgb) / 12%);
        border-radius: 12px;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow:
          0 8px 32px rgb(0 0 0 / 40%),
          inset 0 1px 0 rgb(255 255 255 / 5%);
        color: var(--color-text-primary);
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        line-height: 1.45;
        z-index: 999;
        animation: cookie-in 0.4s ease both;
      }
      @keyframes cookie-in {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      #cookie-message[hidden] {
        display: none;
      }
      #cookie-message .cookie-mark {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        color: var(--color-accent);
        background: rgb(var(--color-accent-rgb) / 12%);
        border: 1px solid rgb(var(--color-accent-rgb) / 20%);
        border-radius: 50%;
      }
      #cookie-message .cookie-mark svg {
        width: 16px;
        height: 16px;
      }
      #cookie-message .cookie-body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
      }
      #cookie-message .cookie-title {
        margin: 0;
        font-size: 0.875rem;
        font-weight: 650;
        letter-spacing: 0.01em;
        color: #fff;
      }
      #cookie-message p {
        margin: 0;
        color: rgb(var(--color-text-rgb) / 75%);
      }
      #cookie-message .cookie-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
      }
      #cookie-message button.cookie-dismiss {
        padding: 0.375rem 0.875rem;
        font: inherit;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-bg-primary);
        background: var(--color-accent);
        border: 0;
        border-radius: 999px;
        cursor: pointer;
        transition:
          background 0.15s ease,
          box-shadow 0.2s ease;
      }
      #cookie-message button.cookie-dismiss:hover {
        background: #5ce3ff;
        box-shadow: 0 0 16px rgb(var(--color-accent-rgb) / 40%);
      }
      #cookie-message button.cookie-dismiss:focus-visible,
      #cookie-message:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
      }
      @media (max-width: 767px) {
        #cookie-message {
          right: calc(var(--edge-gap) + env(safe-area-inset-right));
          max-width: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        #cookie-message {
          animation: none;
        }
      }
      @supports not (backdrop-filter: blur(16px)) {
        #cookie-message {
          background: rgb(var(--color-bg-rgb) / 95%);
        }
      }
      /* Content wrapper with glass panel styling */
      .content-wrapper {
        position: fixed;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding-top: calc(
          var(--edge-gap) + var(--player-h) + var(--edge-gap) + env(safe-area-inset-top)
        );
        padding-bottom: calc(
          var(--edge-gap) + var(--footer-h) + var(--edge-gap) + env(safe-area-inset-bottom)
        );
        /* No horizontal padding - blog-panel handles its own width */
        padding-left: 0;
        padding-right: 0;
        box-sizing: border-box;
        overflow: hidden;
      }
      /* Blog panel with glass effect - matches the player bar and footer width */
      .blog-panel {
        position: relative;
        z-index: 2;
        /* Unified width system - matches the player bar and footer */
        width: calc((100% - var(--h-inset)) * var(--content-w));
        max-width: calc((1200px - var(--h-inset)) * var(--content-w));
        height: 100%;
        box-sizing: border-box;
        margin: 0;
        padding: 1.5rem 2rem 2rem;
        border-radius: 20px;
        background: rgba(10, 10, 15, 0.18);
        border: 1px solid rgba(0, 212, 255, 0.1);
        box-shadow:
          0 16px 48px rgba(0, 0, 0, 0.5),
          0 0 60px rgba(0, 212, 255, 0.03),
          inset 0 1px 0 rgba(255, 255, 255, 0.03);
        color: var(--color-text-primary);
        overflow-y: auto;
      }
      .blog-panel__header {
        margin-bottom: 0.75rem;
      }
      .blog-panel__title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 650;
        letter-spacing: 0.01em;
        color: var(--color-text-primary);
        text-shadow: 0 0 30px rgba(0, 212, 255, 0.3);
      }
      .blog-panel__subtitle {
        margin: 0.25rem 0 0;
        opacity: 0.75;
        line-height: 1.4;
      }
      .blog-panel__content p {
        margin: 0.75rem 0 0;
        line-height: 1.5;
      }
      .blog-panel a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        transition:
          color 0.2s ease,
          text-shadow 0.2s ease;
      }
      .blog-panel a:hover {
        color: var(--color-accent);
        text-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
      }
      .blog-panel__list {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0 0;
        display: grid;
        gap: 0.6rem;
      }
      .blog-panel__item {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        transition:
          background 0.2s ease,
          border-color 0.2s ease;
        border: 1px solid transparent;
      }
      .blog-panel__item:hover {
        background: rgba(0, 212, 255, 0.05);
        border-color: rgba(0, 212, 255, 0.1);
      }
      @media (max-width: 600px) {
        .content-wrapper {
          /* No container padding - blog-panel width formula handles margins */
          padding-left: 0;
          padding-right: 0;
        }
        .blog-panel {
          /* Keep using unified width formula - it handles margins via --h-inset */
          padding: 1.25rem 1.25rem 1.5rem;
          border-radius: 16px;
        }
        .blog-panel__item {
          justify-content: flex-start;
          gap: 0.35rem 0.75rem;
        }
        .blog-panel__date {
          width: 100%;
          font-size: 0.85rem;
        }
      }
      .blog-panel__date {
        opacity: 0.6;
        white-space: nowrap;
        font-size: 0.9rem;
      }
      .blog-panel__more {
        margin-top: 0.9rem;
      }
      /* Footer - no box, icons float freely */
      footer {
        background: transparent !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        border: none !important;
        box-shadow: none !important;
      }
      footer nav ul li a {
        transition: transform 0.15s ease !important;
      }
      footer nav ul li a:hover {
        transform: scale(1.1);
      }
      /* Reduced motion support */
      @media (prefers-reduced-motion: reduce) {
        .blog-panel__item,
        footer nav ul li a {
          transition: none !important;
        }
        .blog-panel__item:hover,
        footer nav ul li a:hover {
          transform: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <!-- Three.js Space Background -->
    <SpaceBackground />
    <main class="content-wrapper" id="main-content">
      <section id="blog-slot" class="blog-panel" aria-label="Blog">
        <header class="blog-panel__header">
          <h2 class="blog-panel__title">Blog</h2>
          <p class="blog-panel__subtitle">Latest updates and notes.</p>
        </header>

        <div class="blog-panel__content">
          {posts.length ? (
            <ul class="blog-panel__list">
              {posts.map((p) => (
                <li class="blog-panel__item">
                  <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                  <small class="blog-panel__date">{p.data.date.toISOString().slice(0, 10)}</small>
                </li>
              ))}
            </ul>
          ) : (
            <p>No posts yet — check back soon.</p>
          )}

          <p class="blog-panel__more">
            <a href="/blog/">All posts &rarr;</a>
          </p>
        </div>
      </section>
    </main>
    <BandcampPlayer />
    <div id="cookie-message" role="status" aria-live="polite" aria-label="Cookie notice" hidden>
      <span class="cookie-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <circle
            cx="12"
            cy="12"
            r="10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
          ></circle>
          <circle cx="8" cy="9" r="1.5"></circle>
          <circle cx="15" cy="8" r="1.2"></circle>
          <circle cx="10" cy="14" r="1.3"></circle>
          <circle cx="16" cy="14" r="1"></circle>
        </svg>
      </span>
      <div class="cookie-body">
        <p class="cookie-title">No cookies from us</p>
        <p>
          This site sets no cookies and runs no analytics. The music player is embedded from
          Bandcamp, which may set its own cookies when it loads.
        </p>
        <div class="cookie-actions">
          <button type="button" class="cookie-dismiss" data-cookie-dismiss>
            OK
          </button>
        </div>
      </div>
    </div>

    <footer role="contentinfo">
      <SocialLinks />
    </footer>

    <script>
      // Cookie notice - must work with View Transitions
      const COOKIE_KEY = "cookie_notice_dismissed";

      function hasDismissed(): boolean {
        try {
          return localStorage.getItem(COOKIE_KEY) === "true";
        } catch {
          return false;
        }
      }

      function saveDismissal(): void {
        try {
          localStorage.setItem(COOKIE_KEY, "true");
        } catch {
          // Silently fail
        }
      }

      function initCookieNotice(): void {
        const notice = document.getElementById("cookie-message");
        if (!notice) return;

        // Ships hidden; only revealed for visitors who have not dismissed it
        if (hasDismissed()) {
          notice.hidden = true;
          return;
        }
        notice.hidden = false;
        if (notice.dataset.bound === "true") return;
        notice.dataset.bound = "true";

        const close = (): void => {
          saveDismissal();
          notice.hidden = true;
          document.removeEventListener("keydown", onKeydown);
        };
        // A polite status region needs no focus and must not trap Tab;
        // Escape is a convenience while the notice is showing.
        const onKeydown = (event: KeyboardEvent): void => {
          if (event.key === "Escape" && !notice.hidden) close();
        };
        notice.querySelector("[data-cookie-dismiss]")?.addEventListener("click", close);
        document.addEventListener("keydown", onKeydown);
      }

      initCookieNotice();
      document.addEventListener("astro:page-load", initCookieNotice);
    </script>
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
