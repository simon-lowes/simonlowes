    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />

    <!-- View Transitions for seamless navigation -->
    <ViewTransitions />

    <meta name="google-site-verification" content="gwurdptI6ejhc1SisVjfxFNaGX2lU19i646cuMxbK20" />
    <meta
      name="keywords"
      content="Simon Lowes, Musician, Performer, Tours, Music, Lowes, Simon, Song, Songwriter, Writer, Guitar, Guitarist, Synthesizer, Drums, Alternative, Rock, Rock and Roll, Alternative Rock Musician, Rock Artist, Artist, Alternative Music, Singer-songwriter, Band, Indie rock, Alternative sound, Music producer, Production, Melodic Rock, Moderate Rock, Singer, Vocalist, Song composition, Alternative Genre, Slowburn, Slowburner, Live performance, Live Music, Live, Studio Recording, Saltwell Studio, Chris Pepper, Rob Baldock, re:liverecordings, Music Industry, Alternative Rock Band, Alt Rock, Creative Expression, Alternative Pop, Pop, Pop Music, Solo, Lyrics, SoundCloud, Apple Music, Spotify, BandCamp, YouTube-Music, Deezer, Amazon Music, Pandora, Tidal, iHeartRadio, Napster, JioSaavn, Gaana, Tencent Music, Anghami, Yandex Music, QQ Music, KKBOX, Wynk Music, Boomplay, YouTube, Genre-bending, Music Streaming, Streaming, Simon Lowe, Simon Low, Lowes Simon, Lowe Simon, Low Simon, Simon Lowes Musician, Simon Lowe Musician, Simon Low Musician, Lowes Simon Musician, Lowe Simon Musician, Low Simon Musician, Simon Lowes Music, Simon Lowe Music, Simon Low Music, Lowes Simon Music, Lowe Simon Music, Low Simon Music, Lowes Simon Music, Lowe Simon Music, Low Simon Music, Simon Lowes Singer, Simon Lowe Singer, Simon Low Singer, Lowes Simon Singer, Lowe Simon Singer, Simon Lowes Songwriter, Simon Lowe Songwriter, Simon Low Songwriter, Lowes Simon Songwriter, Lowe Simon Songwriter, Low Simon Songwriter, Simon Lowes Artist, Simon Lowe Artist, Simon Low Artist, Lowes Simon Artist, Lowe Simon Artist, Low Simon Artist, Simom Lowes Songs, Simon Lowe Songs, Simon Low Songs, Simon Lowes Band, Simon Lowe Band, Simon Low Band, Band Simon Lowes, Band Simon Lowe, Band Simon Low, Lowes Simon Band, Lowe Simon Band, Low Simon Band, Simon Lowes Ablums, Simon Lowe Albums, Simon Low Albums, Lowes Simon Albums, Lowe Simon Albums, Low Simon Albums, Simon Lowes Singles, Simon Lowe Singles, Simon Low Singles, Lowes Simon Singles, Lowe Simon Singles, Low Simon Singles, Simon Lowes Discography, Simon Lowe Discography, Simon Low Discography, Lowes Simon Discography, Lowe Simon Discography, Low Simon Discography, Simon Lowes Musical Artist, Simon Lowe Musical Artist, Simon Low Musical Artist, Lowes Simon Musical Artist, Lowe Simon Musical Artist, Low Simon Musical Artist, Simon Lowes Biography, Simon Lowe Biography, Simon Low Biography, Lowes Simon Biography, Lowe Simon Biography, Low Simon Biography, Simon Lowes Official Website, Simon Lowe Official Website, Simon Low Official Website, Lowes Simon Official Website, Lowe Simon Official Website, Low Simon Offical Website, Blues, Punk Rock, Acoustic Guitar, Electric Guitar, Fender, Gibson, Les Paul, Telecaster, Martin Guitar, Gibson Guitar, Fender Guitar, Fender Telecaster, Riffs, Instagram, Facebook, Tumblr, Twitter, TikTok, YouTube, Imitate Song, Slowburner Album, Time Song, Stolen Moment Song, Nobody Else Song, False Light Song, Mother Earth Song, For As Long As It Can Be Song, Here Right Now Song, Turn Me Off Song, Eternity Song, When It Falls Song, Air Song, Nobody Song, Slow Motion Song, Simon Loe, Simon Loes, Simon Loze"
    />
    <meta name="robots" content="index, follow" />
    <style>
      /* Skip-link styles now in global CSS (public/css/style.css) */

      /* Cookie notice - minimal bottom-left banner per web standards */
      #cookie-message {
        position: fixed;
        bottom: 1rem;
        left: 1rem;
        max-width: 280px;
        background: rgba(20, 20, 30, 0.92);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
        font-family: "freight-sans-pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 0.8125rem;
        line-height: 1.4;
        z-index: 999;
      }
      #cookie-message[hidden] {
        display: none;
      }
      #cookie-message p {
        margin: 0 0 0.5rem;
      }
      #cookie-message .cookie-icon {
        display: inline-block;
        width: 1em;
        height: 1em;
        vertical-align: -0.1em;
        margin-right: 0.4em;
        opacity: 0.75;
      }
      #cookie-message .cookie-actions {
        display: flex;
        justify-content: flex-end;
      }
      #cookie-message button.cookie-dismiss {
        padding: 0.375rem 0.75rem;
        font-size: 0.75rem;
        background: rgba(0, 212, 255, 0.12);
        border: 1px solid rgba(0, 212, 255, 0.25);
        border-radius: 4px;
        color: #00d4ff;
        cursor: pointer;
        transition: background 0.15s ease;
      }
      #cookie-message button.cookie-dismiss:hover {
        background: rgba(0, 212, 255, 0.22);
      }
      #cookie-message button.cookie-dismiss:focus-visible {
        outline: 2px solid rgba(0, 212, 255, 0.5);
        outline-offset: 2px;
      }
      @media (max-width: 480px) {
        #cookie-message {
          left: 0.75rem;
          right: 0.75rem;
          bottom: 0.75rem;
          max-width: none;
        }
      }
      /* Content wrapper with glass panel styling */
      .content-wrapper {
        position: fixed;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding-top: calc(
          var(--edge-gap) + var(--player-h) + var(--edge-gap) + env(safe-area-inset-top)
        );
        padding-bottom: calc(
          var(--edge-gap) + var(--footer-h) + var(--edge-gap) + env(safe-area-inset-bottom)
        );
        /* No horizontal padding - blog-panel handles its own width */
        padding-left: 0;
        padding-right: 0;
        box-sizing: border-box;
        overflow: hidden;
      }
      /* Blog panel with glass effect - matches audio player and footer width */
      .blog-panel {
        position: relative;
        z-index: 2;
        /* Unified width system - matches audio player and footer */
        width: calc((100% - var(--h-inset)) * var(--content-w));
        max-width: calc((1200px - var(--h-inset)) * var(--content-w));
        height: 100%;
        box-sizing: border-box;
        margin: 0;
        padding: 1.5rem 2rem 2rem;
        border-radius: 20px;
        background: rgba(10, 10, 15, 0.18);
        border: 1px solid rgba(0, 212, 255, 0.1);
        box-shadow:
          0 16px 48px rgba(0, 0, 0, 0.5),
          0 0 60px rgba(0, 212, 255, 0.03),
          inset 0 1px 0 rgba(255, 255, 255, 0.03);
        color: #e0e0e0;
        overflow-y: auto;
      }
      .blog-panel__header {
        margin-bottom: 0.75rem;
      }
      .blog-panel__title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 650;
        letter-spacing: 0.01em;
        color: #e0e0e0;
        text-shadow: 0 0 30px rgba(0, 212, 255, 0.3);
      }
      .blog-panel__subtitle {
        margin: 0.25rem 0 0;
        opacity: 0.75;
        line-height: 1.4;
      }
      .blog-panel__content p {
        margin: 0.75rem 0 0;
        line-height: 1.5;
      }
      .blog-panel a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        transition:
          color 0.2s ease,
          text-shadow 0.2s ease;
      }
      .blog-panel a:hover {
        color: #00d4ff;
        text-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
      }
      .blog-panel__list {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0 0;
        display: grid;
        gap: 0.6rem;
      }
      .blog-panel__item {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        transition:
          background 0.2s ease,
          border-color 0.2s ease;
        border: 1px solid transparent;
      }
      .blog-panel__item:hover {
        background: rgba(0, 212, 255, 0.05);
        border-color: rgba(0, 212, 255, 0.1);
      }
      @media (max-width: 600px) {
        .content-wrapper {
          /* No container padding - blog-panel width formula handles margins */
          padding-left: 0;
          padding-right: 0;
        }
        .blog-panel {
          /* Keep using unified width formula - it handles margins via --h-inset */
          padding: 1.25rem 1.25rem 1.5rem;
          border-radius: 16px;
        }
        .blog-panel__item {
          justify-content: flex-start;
          gap: 0.35rem 0.75rem;
        }
        .blog-panel__date {
          width: 100%;
          font-size: 0.85rem;
        }
      }
      .blog-panel__date {
        opacity: 0.6;
        white-space: nowrap;
        font-size: 0.9rem;
      }
      .blog-panel__more {
        margin-top: 0.9rem;
      }
      /* Footer - no box, icons float freely */
      footer {
        background: transparent !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        border: none !important;
        box-shadow: none !important;
      }
      footer nav ul li a {
        transition: transform 0.15s ease !important;
      }
      footer nav ul li a:hover {
        transform: scale(1.1);
      }
      footer nav ul li a img {
        transition: filter 0.3s ease;
      }
      /* Brand colors on hover - official hex colors */
      /* Bandcamp: #629aa9 (teal) */
      footer nav ul li a[data-social="bandcamp"]:hover img {
        filter: brightness(0) saturate(100%) invert(58%) sepia(18%) saturate(683%)
          hue-rotate(148deg) brightness(94%) contrast(89%) drop-shadow(0 0 8px #629aa9);
      }
      /* Spotify: #1DB954 (green) */
      footer nav ul li a[data-social="spotify"]:hover img {
        filter: brightness(0) saturate(100%) invert(53%) sepia(94%) saturate(421%)
          hue-rotate(101deg) brightness(91%) contrast(87%) drop-shadow(0 0 8px #1db954);
      }
      /* Apple Music: #FA57C1 (pink) */
      footer nav ul li a[data-social="apple-music"]:hover img {
        filter: brightness(0) saturate(100%) invert(48%) sepia(96%) saturate(1547%)
          hue-rotate(300deg) brightness(98%) contrast(97%) drop-shadow(0 0 8px #fa57c1);
      }
      /* YouTube Music: #FF0000 (red) */
      footer nav ul li a[data-social="youtube-music"]:hover img {
        filter: brightness(0) saturate(100%) invert(12%) sepia(97%) saturate(7471%) hue-rotate(4deg)
          brightness(104%) contrast(117%) drop-shadow(0 0 8px #ff0000);
      }
      /* YouTube: #FF0000 (red) */
      footer nav ul li a[data-social="youtube"]:hover img {
        filter: brightness(0) saturate(100%) invert(12%) sepia(97%) saturate(7471%) hue-rotate(4deg)
          brightness(104%) contrast(117%) drop-shadow(0 0 8px #ff0000);
      }
      /* Instagram: #E4405F (gradient pink - using primary) */
      footer nav ul li a[data-social="instagram"]:hover img {
        filter: brightness(0) saturate(100%) invert(36%) sepia(69%) saturate(2234%)
          hue-rotate(326deg) brightness(95%) contrast(93%) drop-shadow(0 0 8px #e4405f);
      }
      /* Enhanced audio player glass styling */
      .audio-player {
        background: rgba(10, 10, 15, 0.18) !important;
        border: 1px solid rgba(0, 212, 255, 0.1) !important;
        box-shadow:
          0 8px 32px rgba(0, 0, 0, 0.4),
          0 0 40px rgba(0, 212, 255, 0.03) !important;
      }
      .audio-player__play {
        background: rgba(0, 212, 255, 0.15) !important;
        border: 1px solid rgba(0, 212, 255, 0.2);
        transition:
          background 0.2s ease,
          transform 0.15s ease,
          box-shadow 0.3s ease !important;
      }
      .audio-player__play:hover {
        background: rgba(0, 212, 255, 0.25) !important;
        box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
      }
      .audio-player__seek::-webkit-slider-thumb {
        background: #00d4ff !important;
        box-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
      }
      .audio-player__seek::-moz-range-thumb {
        background: #00d4ff !important;
        box-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
      }
      .audio-player__volume-slider::-webkit-slider-thumb {
        background: #00d4ff !important;
      }
      .audio-player__volume-slider::-moz-range-thumb {
        background: #00d4ff !important;
      }
      /* Reduced motion support */
      @media (prefers-reduced-motion: reduce) {
        .blog-panel__item,
        footer nav ul li a,
        .audio-player__play {
          transition: none !important;
        }
        .blog-panel__item:hover,
        footer nav ul li a:hover {
          transform: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <!-- Three.js Space Background -->
    <SpaceBackground />
    <main class="content-wrapper" id="main-content">
      <section id="blog-slot" class="blog-panel" aria-label="Blog">
        <header class="blog-panel__header">
          <h2 class="blog-panel__title">Blog</h2>
          <p class="blog-panel__subtitle">Latest updates and notes.</p>
        </header>

        <div class="blog-panel__content">
          {
            posts.length ? (
              <ul class="blog-panel__list">
                {posts.map((p) => (
                  <li class="blog-panel__item">
                    <a href={`/blog/${p.slug}/`}>{p.data.title}</a>
                    <small class="blog-panel__date">{p.data.date.toISOString().slice(0, 10)}</small>
                  </li>
                ))}
              </ul>
            ) : (
              <p>No posts yet — check back soon.</p>
            )
          }

          <p class="blog-panel__more">
            <a href="/blog/">All posts &rarr;</a>
          </p>
        </div>
      </section>
    </main>
    <!-- Audio Player Component -->
    <div
      class="audio-player"
      id="audio-player"
      role="region"
      aria-label="Audio player for Never There"
    >
      <audio id="myAudio" src="/neverthere.mp3" preload="metadata"></audio>

      <!-- Play/Pause Button -->
      <button
        type="button"
        class="audio-player__play"
        id="audio-play-btn"
        aria-label="Play Never There"
        aria-pressed="false"
      >
        <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z"></path>
        </svg>
        <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
        </svg>
      </button>

      <!-- Time Display (Elapsed) -->
      <span
        class="audio-player__time audio-player__time--elapsed"
        id="audio-time-elapsed"
        aria-live="off">0:00</span
      >

      <!-- Seek Slider -->
      <input
        type="range"
        class="audio-player__seek"
        id="audio-seek"
        min="0"
        max="100"
        value="0"
        step="0.1"
        aria-label="Seek slider"
      />

      <!-- Time Display (Remaining) -->
      <span
        class="audio-player__time audio-player__time--remaining"
        id="audio-time-remaining"
        aria-live="off">-0:00</span
      >

      <!-- Volume Controls -->
      <div class="audio-player__volume">
        <button
          type="button"
          class="audio-player__mute"
          id="audio-mute-btn"
          aria-label="Mute audio"
          aria-pressed="false"
        >
          <svg class="icon-volume" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
            ></path>
          </svg>
          <svg class="icon-muted" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
            ></path>
          </svg>
        </button>
        <input
          type="range"
          class="audio-player__volume-slider"
          id="audio-volume"
          min="0"
          max="100"
          value="75"
          step="1"
          aria-label="Volume slider"
        />
      </div>
    </div>
    <div
      id="cookie-message"
      role="status"
      aria-live="polite"
      aria-label="Cookie notice"
      tabindex="-1"
    >
      <p>
        <svg class="cookie-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5"
          ></circle><circle cx="8" cy="9" r="1.5"></circle><circle cx="15" cy="8" r="1.2"
          ></circle><circle cx="10" cy="14" r="1.3"></circle><circle cx="16" cy="14" r="1"
          ></circle></svg
        >This site doesn't use cookies or trackers.
      </p>
      <div class="cookie-actions">
        <button type="button" class="cookie-dismiss" aria-label="Dismiss" data-cookie-dismiss
          >Got it</button
        >
      </div>
    </div>

    <footer role="contentinfo">
      <nav aria-label="Social media and music platforms">
        <ul>
          <li>
            <a
              href="https://simonlowes.bandcamp.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit Simon Lowes on BandCamp (opens in new tab)"
              data-social="bandcamp"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/bandcamp.png"
                alt="BandCamp icon"
              /></a
            >
          </li>
          <li>
            <a
              href="https://open.spotify.com/artist/1E8slBJPNvUSPpRIh3xtkI?si=LOjXYVnQRhiZU6XmjkUdhg"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Listen to Simon Lowes on Spotify (opens in new tab)"
              data-social="spotify"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/spotify.png"
                alt="Spotify icon"
              /></a
            >
          </li>
          <li>
            <a
              href="https://music.apple.com/gb/artist/simon-lowes/1351008298"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Listen to Simon Lowes on Apple Music (opens in new tab)"
              data-social="apple-music"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/apple-music.png"
                alt="Apple Music icon"
              /></a
            >
          </li>
          <li>
            <a
              href="https://music.youtube.com/channel/UCI4xshiWQrOu_27TPmW9A2g?feature=share"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Listen to Simon Lowes on YouTube Music (opens in new tab)"
              data-social="youtube-music"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/youtube-music.png"
                alt="YouTube Music icon"
              /></a
            >
          </li>
          <li>
            <a
              href="https://www.youtube.com/simonlowesmusic"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Watch Simon Lowes on YouTube (opens in new tab)"
              data-social="youtube"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/youtube-play.png"
                alt="YouTube icon"
              /></a
            >
          </li>
          <li>
            <a
              href="https://www.instagram.com/simonlowesmusic/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Follow Simon Lowes on Instagram (opens in new tab)"
              data-social="instagram"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/instagram-new.png"
                alt="Instagram icon"
              /></a
            >
          </li>
        </ul>
      </nav>
    </footer>

    <script>
      // Cookie notice - must work with View Transitions
      const COOKIE_KEY = "cookie_notice_dismissed";

      function hasDismissed(): boolean {
        try {
          return localStorage.getItem(COOKIE_KEY) === "true";
        } catch {
          return false;
        }
      }

      function saveDismissal(): void {
        try {
          localStorage.setItem(COOKIE_KEY, "true");
        } catch {
          // Silently fail
        }
      }

      function initCookieNotice(): void {
        const notice = document.getElementById("cookie-message");
        if (!notice) return;

        // Always check dismissal state on navigation (View Transitions)
        if (hasDismissed()) {
          notice.setAttribute("hidden", "");
          return;
        }

        // Show the notice if not dismissed
        notice.removeAttribute("hidden");

        const dismiss = notice.querySelector("[data-cookie-dismiss]");
        const previouslyFocused = document.activeElement as HTMLElement | null;

        const closeNotice = (): void => {
          saveDismissal();
          notice.setAttribute("hidden", "");
          notice.removeAttribute("aria-modal");
          if (previouslyFocused?.focus) {
            previouslyFocused.focus();
          }
        };

        // Remove old listeners to avoid duplicates on re-navigation
        const newDismiss = dismiss?.cloneNode(true) as HTMLElement | null;
        if (dismiss && newDismiss) {
          dismiss.parentNode?.replaceChild(newDismiss, dismiss);
          newDismiss.addEventListener("click", closeNotice);
        }

        // Focus the notice for accessibility
        if (!notice.hasAttribute("hidden")) {
          requestAnimationFrame(() => notice.focus());
        }

        // Handle keyboard events (clone to remove old listeners)
        const handleKeydown = (event: KeyboardEvent): void => {
          if (event.key === "Escape" || event.key === "Esc") {
            event.preventDefault();
            closeNotice();
          } else if (event.key === "Tab" && newDismiss) {
            event.preventDefault();
            newDismiss.focus();
          }
        };

        // Use a flag to prevent duplicate keydown listeners
        if (!notice.dataset.keydownAttached) {
          notice.addEventListener("keydown", handleKeydown as EventListener);
          notice.dataset.keydownAttached = "true";
        }
      }

      // Run on initial load and after View Transitions navigation
      document.addEventListener("astro:page-load", initCookieNotice);
    </script>
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
