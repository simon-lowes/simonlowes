    <style>
      .skip-link {
        position: absolute;
        top: 0.5rem;
        left: 50%;
        transform: translate(-50%, -150%);
        background: rgba(0, 212, 255, 0.9);
        color: #0a0a0f;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
        z-index: 1000;
        transition: transform 0.2s ease;
      }
      .skip-link:focus {
        transform: translate(-50%, 0);
        outline: 2px solid #fff;
        outline-offset: 3px;
      }
      #cookie-message {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(90vw, 420px);
        background: rgba(10, 10, 15, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        color: #e0e0e0;
        border: 1px solid rgba(0, 212, 255, 0.15);
        border-radius: 16px;
        padding: 1.25rem 1.5rem 1.5rem;
        box-shadow:
          0 18px 45px rgba(0, 0, 0, 0.5),
          0 0 40px rgba(0, 212, 255, 0.05);
        font-family: "freight-sans-pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
        z-index: 999;
      }
      #cookie-message[hidden] {
        display: none;
      }
      #cookie-message .cookie-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }
      #cookie-message .cookie-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid rgba(0, 212, 255, 0.5);
        position: relative;
        background: transparent;
      }
      #cookie-message .cookie-icon::before,
      #cookie-message .cookie-icon::after {
        content: "";
        position: absolute;
        background: rgba(0, 212, 255, 0.5);
        border-radius: 50%;
      }
      #cookie-message .cookie-icon::before {
        width: 6px;
        height: 6px;
        top: 6px;
        left: 9px;
      }
      #cookie-message .cookie-icon::after {
        width: 5px;
        height: 5px;
        top: 16px;
        right: 6px;
      }
      #cookie-message h2 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 600;
        color: #e0e0e0;
      }
      #cookie-message p {
        margin: 0;
        line-height: 1.4;
        font-size: 1rem;
        color: rgba(224, 224, 224, 0.85);
      }
      #cookie-message button.cookie-dismiss {
        position: absolute;
        top: 0.6rem;
        right: 0.75rem;
        background: none;
        border: none;
        color: rgba(0, 212, 255, 0.7);
        font-size: 1.25rem;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        transition: color 0.2s ease;
      }
      #cookie-message button.cookie-dismiss:hover {
        color: #00d4ff;
      }
      #cookie-message button.cookie-dismiss:focus-visible {
        outline: 2px solid rgba(0, 212, 255, 0.5);
        outline-offset: 2px;
      }
      @media (max-width: 600px) {
        #cookie-message {
          top: 50%;
          padding: 1rem 1.25rem 1.25rem;
        }
        #cookie-message p {
          font-size: 0.95rem;
        }
      }
      /* Content wrapper with glass panel styling */
      .content-wrapper {
        position: fixed;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding-top: calc(
          var(--edge-gap) + var(--player-h) + var(--edge-gap) + env(safe-area-inset-top)
        );
        padding-bottom: calc(
          var(--edge-gap) + var(--footer-h) + var(--edge-gap) + env(safe-area-inset-bottom)
        );
        padding-left: 1rem;
        padding-right: 1rem;
        box-sizing: border-box;
        overflow: hidden;
      }
      /* Blog panel with glass effect */
      .blog-panel {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 800px;
        height: 100%;
        box-sizing: border-box;
        margin: 0;
        padding: 1.5rem 2rem 2rem;
        border-radius: 20px;
        background: rgba(10, 10, 15, 0.75);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(0, 212, 255, 0.1);
        box-shadow:
          0 16px 48px rgba(0, 0, 0, 0.5),
          0 0 60px rgba(0, 212, 255, 0.03),
          inset 0 1px 0 rgba(255, 255, 255, 0.03);
        color: #e0e0e0;
        overflow-y: auto;
      }
      .blog-panel__header {
        margin-bottom: 0.75rem;
      }
      .blog-panel__title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 650;
        letter-spacing: 0.01em;
        color: #e0e0e0;
        text-shadow: 0 0 30px rgba(0, 212, 255, 0.3);
      }
      .blog-panel__subtitle {
        margin: 0.25rem 0 0;
        opacity: 0.75;
        line-height: 1.4;
      }
      .blog-panel__content p {
        margin: 0.75rem 0 0;
        line-height: 1.5;
      }
      .blog-panel a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        transition:
          color 0.2s ease,
          text-shadow 0.2s ease;
      }
      .blog-panel a:hover {
        color: #00d4ff;
        text-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
      }
      .blog-panel__list {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0 0;
        display: grid;
        gap: 0.6rem;
      }
      .blog-panel__item {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        transition:
          background 0.2s ease,
          border-color 0.2s ease;
        border: 1px solid transparent;
      }
      .blog-panel__item:hover {
        background: rgba(0, 212, 255, 0.05);
        border-color: rgba(0, 212, 255, 0.1);
      }
      @media (max-width: 600px) {
        .content-wrapper {
          padding-left: 0.75rem;
          padding-right: 0.75rem;
        }
        .blog-panel {
          padding: 1.25rem 1.25rem 1.5rem;
          border-radius: 16px;
        }
        .blog-panel__item {
          justify-content: flex-start;
          gap: 0.35rem 0.75rem;
        }
        .blog-panel__date {
          width: 100%;
          font-size: 0.85rem;
        }
      }
      .blog-panel__date {
        opacity: 0.6;
        white-space: nowrap;
        font-size: 0.9rem;
      }
      .blog-panel__more {
        margin-top: 0.9rem;
      }
      /* Enhanced footer with glass effect */
      footer {
        background: rgba(10, 10, 15, 0.7) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(0, 212, 255, 0.1) !important;
        box-shadow:
          0 -4px 32px rgba(0, 0, 0, 0.4),
          0 0 40px rgba(0, 212, 255, 0.03) !important;
      }
      footer nav ul li a {
        transition:
          background 0.2s ease,
          transform 0.15s ease,
          filter 0.3s ease !important;
      }
      footer nav ul li a:hover {
        background: rgba(0, 212, 255, 0.15) !important;
        filter: drop-shadow(0 0 8px rgba(0, 212, 255, 0.5));
      }
      footer nav ul li a img {
        transition: filter 0.3s ease;
      }
      footer nav ul li a:hover img {
        filter: drop-shadow(0 0 6px rgba(0, 212, 255, 0.6));
      }
      /* Enhanced audio player glass styling */
      .audio-player {
        background: rgba(10, 10, 15, 0.7) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(0, 212, 255, 0.1) !important;
        box-shadow:
          0 8px 32px rgba(0, 0, 0, 0.4),
          0 0 40px rgba(0, 212, 255, 0.03) !important;
      }
      .audio-player__play {
        background: rgba(0, 212, 255, 0.15) !important;
        border: 1px solid rgba(0, 212, 255, 0.2);
        transition:
          background 0.2s ease,
          transform 0.15s ease,
          box-shadow 0.3s ease !important;
      }
      .audio-player__play:hover {
        background: rgba(0, 212, 255, 0.25) !important;
        box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
      }
      .audio-player__seek::-webkit-slider-thumb {
        background: #00d4ff !important;
        box-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
      }
      .audio-player__seek::-moz-range-thumb {
        background: #00d4ff !important;
        box-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
      }
      .audio-player__volume-slider::-webkit-slider-thumb {
        background: #00d4ff !important;
      }
      .audio-player__volume-slider::-moz-range-thumb {
        background: #00d4ff !important;
      }
      /* Reduced motion support */
      @media (prefers-reduced-motion: reduce) {
        .blog-panel__item,
        footer nav ul li a,
        .audio-player__play {
          transition: none !important;
        }
        .blog-panel__item:hover,
        footer nav ul li a:hover {
          transform: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <!-- Three.js Space Background -->
    <SpaceBackground />
    <main class="content-wrapper" id="main-content">
      <section id="blog-slot" class="blog-panel glass-panel" aria-label="Blog">
        <header class="blog-panel__header">
          <h2 class="blog-panel__title">Blog</h2>
          <p class="blog-panel__subtitle">Latest updates and notes.</p>
        </header>

        <div class="blog-panel__content">
          {
            posts.length ? (
              <ul class="blog-panel__list">
                {posts.map((p) => (
                  <li class="blog-panel__item">
                    <a href={`/blog/${p.slug}/`}>{p.data.title}</a>
                    <small class="blog-panel__date">{p.data.date.toISOString().slice(0, 10)}</small>
                  </li>
                ))}
              </ul>
            ) : (
              <p>No posts yet — check back soon.</p>
            )
          }

          <p class="blog-panel__more">
            <a href="/blog/">All posts &rarr;</a>
          </p>
        </div>
      </section>
    </main>
    <!-- Audio Player Component -->
    <div
      class="audio-player"
      id="audio-player"
      role="region"
      aria-label="Audio player for Never There"
    >
      <audio id="myAudio" src="/neverthere.mp3" preload="metadata"></audio>

      <!-- Play/Pause Button -->
      <button
        type="button"
        class="audio-player__play"
        id="audio-play-btn"
        aria-label="Play Never There"
        aria-pressed="false"
      >
        <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z"></path>
        </svg>
        <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
        </svg>
      </button>

      <!-- Time Display (Elapsed) -->
      <span
        class="audio-player__time audio-player__time--elapsed"
        id="audio-time-elapsed"
        aria-live="off">0:00</span
      >

      <!-- Seek Slider -->
      <input
        type="range"
        class="audio-player__seek"
        id="audio-seek"
        min="0"
        max="100"
        value="0"
        step="0.1"
        aria-label="Seek slider"
      />

      <!-- Time Display (Remaining) -->
      <span
        class="audio-player__time audio-player__time--remaining"
        id="audio-time-remaining"
        aria-live="off">-0:00</span
      >

      <!-- Volume Controls -->
      <div class="audio-player__volume">
        <button
          type="button"
          class="audio-player__mute"
          id="audio-mute-btn"
          aria-label="Mute audio"
          aria-pressed="false"
        >
          <svg class="icon-volume" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
            ></path>
          </svg>
          <svg class="icon-muted" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
            ></path>
          </svg>
        </button>
        <input
          type="range"
          class="audio-player__volume-slider"
          id="audio-volume"
          min="0"
          max="100"
          value="75"
          step="1"
          aria-label="Volume slider"
        />
      </div>
    </div>
    <div
      id="cookie-message"
      role="dialog"
      aria-live="polite"
      aria-label="Cookie notice"
      aria-modal="true"
      tabindex="-1"
    >
      <button
        type="button"
        class="cookie-dismiss"
        aria-label="Close cookie notice"
        data-cookie-dismiss
      >
        &times;
      </button>
      <div class="cookie-header">
        <span class="cookie-icon" aria-hidden="true"></span>
        <h2>Cookie Notice</h2>
      </div>
      <p>
        This site does not currently use cookies or similar trackers. If that changes, this notice
        will be updated. Close this message to continue browsing.
      </p>
    </div>

    <footer role="contentinfo">
      <nav aria-label="Social media and music platforms">
        <ul>
          <li>
            <a
              href="https://simonlowes.bandcamp.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit Simon Lowes on BandCamp (opens in new tab)"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/bandcamp.png"
                alt="BandCamp icon"
              /></a
            >
          </li>
          <li>
            <a
              href="https://open.spotify.com/artist/1E8slBJPNvUSPpRIh3xtkI?si=LOjXYVnQRhiZU6XmjkUdhg"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Listen to Simon Lowes on Spotify (opens in new tab)"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/spotify.png"
                alt="Spotify icon"
              /></a
            >
          </li>
          <li>
            <a
              href="https://music.apple.com/gb/artist/simon-lowes/1351008298"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Listen to Simon Lowes on Apple Music (opens in new tab)"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/apple-music.png"
                alt="Apple Music icon"
              /></a
            >
          </li>
          <li>
            <a
              href="https://music.youtube.com/channel/UCI4xshiWQrOu_27TPmW9A2g?feature=share"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Listen to Simon Lowes on YouTube Music (opens in new tab)"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/youtube-music.png"
                alt="YouTube Music icon"
              /></a
            >
          </li>
          <li>
            <a
              href="https://soundcloud.com/simonlowesmusic"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Listen to Simon Lowes on SoundCloud (opens in new tab)"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/soundcloud.png"
                alt="SoundCloud icon"
              /></a
            >
          </li>
          <li>
            <a
              href="https://www.youtube.com/simonlowesmusic"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Watch Simon Lowes on YouTube (opens in new tab)"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/youtube-play.png"
                alt="YouTube icon"
              /></a
            >
          </li>
          <li>
            <a
              href="https://www.instagram.com/simonlowesmusic/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Follow Simon Lowes on Instagram (opens in new tab)"
              ><img
                src="https://img.icons8.com/ios-filled/50/ffffff/instagram-new.png"
                alt="Instagram icon"
              /></a
            >
          </li>
        </ul>
      </nav>
    </footer>

    <script>
      (function () {
        var notice = document.getElementById("cookie-message");
        if (!notice) {
          return;
        }
        var dismiss = notice.querySelector("[data-cookie-dismiss]");
        var previouslyFocused = document.activeElement;
        var closeNotice = function () {
          notice.setAttribute("hidden", "");
          notice.removeAttribute("aria-modal");
          if (previouslyFocused && previouslyFocused.focus) {
            previouslyFocused.focus();
          }
        };
        if (dismiss) {
          dismiss.addEventListener("click", closeNotice);
        }
        if (!notice.hasAttribute("hidden")) {
          window.requestAnimationFrame(function () {
            notice.focus();
          });
        }
        notice.addEventListener("keydown", function (event) {
          if (event.key === "Escape" || event.key === "Esc") {
            event.preventDefault();
            closeNotice();
          } else if (event.key === "Tab" && dismiss) {
            event.preventDefault();
            dismiss.focus();
          }
        });
      })();
    </script>
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
