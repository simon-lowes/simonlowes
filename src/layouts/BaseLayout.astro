---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogType = "website",
  publishedTime,
  noIndex = false,
} = Astro.props;

const siteUrl = "https://simonlowes.com";
const fullCanonicalUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noIndex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow" />
      )
    }

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={fullCanonicalUrl} />
    <meta property="og:site_name" content="Simon Lowes" />
    {
      publishedTime && ogType === "article" && (
        <>
          <meta property="article:published_time" content={publishedTime} />
          <meta property="article:author" content="Simon Lowes" />
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href={fullCanonicalUrl} />

    <!-- Favicons -->
    <link rel="icon" href="/favicons/fav16.ico" type="image/x-icon" sizes="16x16" />
    <link rel="icon" href="/favicons/fav32.ico" type="image/x-icon" sizes="32x32" />
    <link rel="icon" href="/favicons/fav64.ico" type="image/x-icon" sizes="64x64" />
    <link rel="icon" href="/favicons/fav128.ico" type="image/x-icon" sizes="128x128" />
    <link rel="icon" href="/favicons/fav256.ico" type="image/x-icon" sizes="256x256" />

    <!-- PWA -->
    <meta name="theme-color" content="#0f0f0f" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />

    <!-- Styles -->
    <link rel="stylesheet" type="text/css" href="/css/style.css" />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
