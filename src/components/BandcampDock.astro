---
/**
 * BandcampDock - persistent, collapsible Bandcamp player.
 *
 * A pill anchored bottom-right on the footer baseline. Opening it reveals a
 * glass card with Bandcamp's embedded player for the release in
 * src/data/bandcamp.ts. The iframe is only created on first open, so a
 * visitor who never opens it never loads anything from bandcamp.com.
 */
import { BANDCAMP, BANDCAMP_PLAYER_HEIGHT, bandcampEmbedUrl } from "../data/bandcamp";

const { album, artistUrl } = BANDCAMP;
const embedUrl = album.albumId ? bandcampEmbedUrl(album.albumId) : "";
---

<div class="bc-dock" id="bandcamp-dock" data-open="false">
  <div
    class="bc-dock__panel"
    id="bandcamp-dock-panel"
    role="region"
    aria-label="Bandcamp player"
    hidden
  >
    <div class="bc-dock__head">
      <span class="bc-dock__title">{album.title}</span>
      <a class="bc-dock__link" href={album.url} target="_blank" rel="noopener noreferrer">
        Bandcamp <span aria-hidden="true">&nearr;</span>
        <span class="sr-only"> (opens in new tab)</span>
      </a>
      <button type="button" class="bc-dock__close" aria-label="Close Bandcamp player" data-bc-close>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    {embedUrl ? (
      <div class="bc-dock__player" style={`height:${BANDCAMP_PLAYER_HEIGHT}px`}>
        <iframe
          class="bc-dock__frame"
          data-src={embedUrl}
          title={`Bandcamp player: ${album.title} by Simon Lowes`}
          loading="lazy"
          allow="autoplay"
        ></iframe>
      </div>
    ) : (
      <p class="bc-dock__fallback">
        Stream and buy <em>{album.title}</em> on{" "}
        <a href={artistUrl} target="_blank" rel="noopener noreferrer">
          Bandcamp
        </a>
        .
      </p>
    )}
  </div>
  <button
    type="button"
    class="bc-dock__toggle"
    id="bandcamp-dock-toggle"
    aria-expanded="false"
    aria-controls="bandcamp-dock-panel"
    aria-label={`Listen to ${album.title} on Bandcamp`}
  >
    <img src="/icons/bandcamp.png" alt="" width="20" height="20" />
    <span class="bc-dock__label">Bandcamp</span>
  </button>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Anchor: bottom-right, on the footer baseline, half the page inset from the edge */
  .bc-dock {
    position: fixed;
    right: calc(var(--h-inset) / 2);
    bottom: calc(var(--edge-gap) + env(safe-area-inset-bottom));
    z-index: 101; /* above the footer (100), below the cookie notice (999) */
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    font-family: "freight-sans-pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .bc-dock__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.875rem;
    border: 1px solid rgb(0 212 255 / 10%);
    border-radius: 999px;
    background: rgb(10 10 15 / 70%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #e0e0e0;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    box-shadow:
      0 8px 32px rgb(0 0 0 / 30%),
      inset 0 1px 0 rgb(255 255 255 / 5%);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.15s ease;
  }

  .bc-dock__toggle img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .bc-dock__toggle:hover {
    border-color: rgb(0 212 255 / 20%);
    box-shadow:
      0 8px 32px rgb(0 0 0 / 30%),
      0 0 30px rgb(0 212 255 / 10%),
      inset 0 1px 0 rgb(255 255 255 / 5%);
    transform: scale(1.02);
  }

  .bc-dock__toggle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .bc-dock[data-open="true"] .bc-dock__toggle {
    border-color: rgb(0 212 255 / 25%);
    color: #00d4ff;
  }

  /* The card: same glass as .glass-card */
  .bc-dock__panel {
    width: min(360px, calc(100vw - var(--h-inset)));
    padding: 0.75rem;
    border: 1px solid rgb(0 212 255 / 10%);
    border-radius: 16px;
    background: rgb(10 10 15 / 70%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: #e0e0e0;
    box-shadow:
      0 8px 32px rgb(0 0 0 / 30%),
      0 0 40px rgb(0 212 255 / 5%),
      inset 0 1px 0 rgb(255 255 255 / 5%);
  }

  .bc-dock__panel[hidden] {
    display: none;
  }

  .bc-dock__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .bc-dock__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  .bc-dock__link {
    color: rgb(224 224 224 / 85%);
    font-size: 0.8125rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .bc-dock__link:hover,
  .bc-dock__link:focus-visible {
    color: #00d4ff;
  }

  .bc-dock__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: rgb(224 224 224 / 85%);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .bc-dock__close svg {
    width: 16px;
    height: 16px;
  }

  .bc-dock__close:hover {
    background: rgb(255 255 255 / 10%);
    color: #fff;
  }

  .bc-dock__close:focus-visible,
  .bc-dock__link:focus-visible {
    outline: 2px solid rgb(0 212 255 / 50%);
    outline-offset: 2px;
  }

  .bc-dock__player {
    border-radius: 8px;
    overflow: hidden;
    background: rgb(0 0 0 / 40%);
  }

  .bc-dock__frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .bc-dock__fallback {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: rgb(224 224 224 / 85%);
  }

  .bc-dock__fallback a {
    color: #00d4ff;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Below 768px the footer row is wide enough to reach the corner: icon only */
  @media (width < 768px) {
    .bc-dock {
      right: calc(var(--h-inset) / 2);
    }

    .bc-dock__toggle {
      width: 44px;
      padding: 0;
    }

    .bc-dock__label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bc-dock__toggle,
    .bc-dock__close,
    .bc-dock__link {
      transition: none;
    }

    .bc-dock__toggle:hover {
      transform: none;
    }
  }

  @supports not (backdrop-filter: blur(12px)) {
    .bc-dock__toggle,
    .bc-dock__panel {
      background: rgb(10 10 15 / 95%);
    }
  }
</style>

<script>
  function initBandcampDock(): void {
    const dock = document.getElementById("bandcamp-dock");
    const toggle = document.getElementById("bandcamp-dock-toggle");
    const panel = document.getElementById("bandcamp-dock-panel");
    if (!dock || !toggle || !panel) return;
    if (dock.dataset.bcReady === "true") return;
    dock.dataset.bcReady = "true";

    const frame = panel.querySelector<HTMLIFrameElement>(".bc-dock__frame");

    const setOpen = (open: boolean): void => {
      dock.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
      if (open) {
        // Load Bandcamp only when asked for, and never play two things at once.
        if (frame && !frame.src && frame.dataset.src) frame.src = frame.dataset.src;
        const siteAudio = document.getElementById("myAudio") as HTMLAudioElement | null;
        siteAudio?.pause();
      }
    };

    toggle.addEventListener("click", () => setOpen(panel.hidden));
    panel.querySelector("[data-bc-close]")?.addEventListener("click", () => {
      setOpen(false);
      toggle.focus();
    });
    document.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Escape" && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (event: MouseEvent) => {
      if (!panel.hidden && event.target instanceof Node && !dock.contains(event.target)) {
        setOpen(false);
      }
    });
  }

  initBandcampDock();
  // Astro view transitions swap the body; re-bind on each navigation.
  document.addEventListener("astro:page-load", initBandcampDock);
</script>
