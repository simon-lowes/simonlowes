---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<section id="blog-slot" class="blog-panel" aria-label="Blog">
  <header class="blog-panel__header">
    <h2 class="blog-panel__title">Blog</h2>
    <p class="blog-panel__subtitle">Latest updates and notes.</p>
  </header>

  <div class="blog-panel__content">
    <ul>
      {
        posts.map((p) => (
          <li>
            <a href={`/blog/${p.slug}/`}>{p.data.title}</a>
            <small> {p.data.date.toISOString().slice(0, 10)} </small>
          </li>
        ))
      }
    </ul>

    <p><a href="/blog/">All posts &rarr;</a></p>
  </div>
</section>
