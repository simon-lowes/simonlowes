---
/**
 * SpaceBackground - Astro wrapper for Three.js starfield
 * Creates an immersive cosmic background with parallax star layers
 */
import MotionPermissionPrompt from "./MotionPermissionPrompt.astro";
---

<canvas id="starfield-canvas" aria-hidden="true" transition:persist="starfield"></canvas>
<MotionPermissionPrompt />

<style>
  #starfield-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: -1;
    pointer-events: none;
    background: #0a0a0f;
  }

  /* Fallback gradient for no-WebGL browsers */
  @supports not (display: grid) {
    #starfield-canvas {
      background: linear-gradient(
        135deg,
        #0a0a0f 0%,
        #1a0a2e 25%,
        #0d1b2a 50%,
        #1b263b 75%,
        #0a0a0f 100%
      );
      animation: nebula-drift 30s ease-in-out infinite alternate;
    }

    @keyframes nebula-drift {
      0% {
        background-position: 0% 0%;
      }
      100% {
        background-position: 100% 100%;
      }
    }
  }
</style>

<script>
  const CSS_FALLBACK = `
    radial-gradient(ellipse at 20% 30%, rgba(45, 27, 78, 0.4) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 70%, rgba(13, 27, 42, 0.4) 0%, transparent 50%),
    linear-gradient(135deg, #0a0a0f 0%, #1a0a2e 50%, #0a0a0f 100%)
  `;

  const canvas = document.getElementById("starfield-canvas") as HTMLCanvasElement;

  if (canvas) {
    // Skip Three.js entirely for users who prefer reduced motion —
    // show a static CSS gradient instead (saves ~600KB of JS)
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (prefersReducedMotion) {
      canvas.style.background = CSS_FALLBACK;
    } else {
      // Check WebGL support without consuming the context
      const testCanvas = document.createElement("canvas");
      const hasWebGL = !!(
        testCanvas.getContext("webgl") || testCanvas.getContext("experimental-webgl")
      );

      if (!hasWebGL) {
        canvas.style.background = CSS_FALLBACK;
      } else {
        // Defer Three.js loading to after first paint for better LCP
        const loadStarfield = async () => {
          try {
            const { initStarfield, updateParallax, cleanup } = await import("../scripts/starfield");

            initStarfield(canvas);

            document.addEventListener("mousemove", (e) => {
              const normalizedX = (e.clientX / window.innerWidth) * 2 - 1;
              const normalizedY = (e.clientY / window.innerHeight) * 2 - 1;
              updateParallax(normalizedX, normalizedY);
            });

            window.addEventListener("beforeunload", cleanup);
          } catch {
            canvas.style.background = CSS_FALLBACK;
          }
        };

        // Defer Three.js (602KB) until after page is fully loaded and idle.
        // Note: TBT is inherently high (~8s under 4x throttle) because
        // 602KB JS parsing is a single long task. Only OffscreenCanvas
        // would eliminate it. This deferral at least keeps FCP/LCP clean.
        window.addEventListener("load", () => {
          if ("requestIdleCallback" in window) {
            requestIdleCallback(loadStarfield);
          } else {
            setTimeout(loadStarfield, 100);
          }
        });
      }
    }
  }

  // Handle View Transitions - ensure animation continues after swap
  document.addEventListener("astro:after-swap", () => {
    // Canvas persists, starfield instance remains alive
  });
</script>
