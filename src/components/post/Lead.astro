---
/**
 * Lead - the opening paragraph of a designed post, set larger and lighter
 * so the first lines read like a standfirst. Wrap one paragraph of text.
 */
---

<p class="post-lead">
  <slot />
</p>

<style>
  .post-lead {
    margin: 0 0 1.75rem;
    font-size: 1.25rem;
    line-height: 1.55;
    font-weight: 400;
    color: rgb(224 224 224 / 92%);
  }

  @media (width >= 768px) {
    .post-lead {
      font-size: 1.375rem;
    }
  }
</style>
