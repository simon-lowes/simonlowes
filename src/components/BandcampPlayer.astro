---
/**
 * BandcampPlayer - the site player, streamed by Bandcamp.
 *
 * Sits in the fixed glass bar at the top of every page (the slot the old
 * audio player used) and holds Bandcamp's embedded player for the release in
 * src/data/bandcamp.ts. The embed is transparent, so the glass and the stars
 * show through it.
 *
 * Until the embed has loaded, and whenever no release ID is set, the bar
 * shows a facade: the release title and a link to Bandcamp. The facade fades
 * out the moment the embed is ready, so the bar never flashes empty.
 *
 * From 768px the large embed (120px, artwork thumbnail) is used; below that
 * the small 42px strip. The script picks the size with the same media query
 * the CSS uses, so the iframe height always matches the frame.
 */
import { BANDCAMP, bandcampEmbedUrl } from "../data/bandcamp";

const { release, artistName } = BANDCAMP;
const hasEmbed = release.id !== "";
const label = `Bandcamp player: ${release.title} by ${artistName}`;
---

<div
  class="bc-player"
  id="bandcamp-player"
  role="region"
  aria-label={label}
  data-has-embed={hasEmbed ? "true" : "false"}
>
  <div class="bc-player__frame">
    <a class="bc-player__facade" href={release.url} target="_blank" rel="noopener noreferrer">
      <span class="bc-player__mark" aria-hidden="true">
        <img src="/icons/bandcamp.png" alt="" width="22" height="22" />
      </span>
      <span class="bc-player__text">
        <span class="bc-player__title">{release.title}</span>
        <span class="bc-player__sub">{artistName} · stream and buy on Bandcamp</span>
      </span>
      <span class="bc-player__cta">
        Listen<span class="bc-player__cta-long"> on Bandcamp</span>
        <span aria-hidden="true">&nearr;</span>
        <span class="sr-only"> (opens in new tab)</span>
      </span>
    </a>
    {hasEmbed && <iframe
      class="bc-player__embed"
      title={label}
      data-src-large={bandcampEmbedUrl(release, "large")}
      data-src-small={bandcampEmbedUrl(release, "small")}
      hidden
    ></iframe>}
  </div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* The glass bar: same slot, width formula and glass as the old audio player */
  .bc-player {
    --bc-h: 42px;

    position: fixed;
    top: calc(var(--edge-gap) + env(safe-area-inset-top));
    left: 50%;
    transform: translateX(-50%);
    width: calc((100% - var(--h-inset)) * var(--content-w));
    max-width: calc((1200px - var(--h-inset)) * var(--content-w));
    box-sizing: border-box;
    padding: 0.5rem;
    background: rgb(15 15 15 / 18%);
    border: 1px solid rgb(0 212 255 / 10%);
    border-radius: 12px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      0 8px 32px rgb(0 0 0 / 40%),
      0 0 40px rgb(0 212 255 / 3%),
      inset 0 1px 0 rgb(255 255 255 / 5%);
    color: #e0e0e0;
    font-family: "freight-sans-pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
    z-index: 99;
  }

  .bc-player__frame {
    position: relative;
    height: var(--bc-h);
    border-radius: 8px;
    overflow: hidden;
  }

  /* Facade: shown until the embed is ready, or for good when no ID is set */
  .bc-player__facade {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.5rem;
    color: inherit;
    text-decoration: none;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }

  .bc-player__facade:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
    border-radius: 8px;
  }

  .bc-player__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border: 1px solid rgb(0 212 255 / 20%);
    border-radius: 50%;
    background: rgb(0 212 255 / 15%);
    transition:
      background 0.2s ease,
      box-shadow 0.3s ease,
      transform 0.15s ease;
  }

  .bc-player__mark img {
    width: 18px;
    height: 18px;
  }

  .bc-player__facade:hover .bc-player__mark {
    background: rgb(0 212 255 / 25%);
    box-shadow: 0 0 20px rgb(0 212 255 / 30%);
    transform: scale(1.05);
  }

  .bc-player__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .bc-player__title {
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bc-player__sub {
    display: none;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: rgb(224 224 224 / 60%);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bc-player__cta {
    flex-shrink: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    color: rgb(224 224 224 / 85%);
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .bc-player__cta-long {
    display: none;
  }

  .bc-player__facade:hover .bc-player__cta {
    color: #00d4ff;
  }

  /* The embed: transparent, fades in over the facade once loaded */
  .bc-player__embed {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .bc-player__embed[hidden] {
    display: none;
  }

  .bc-player.is-loaded .bc-player__embed {
    opacity: 1;
  }

  .bc-player.is-loaded .bc-player__facade {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (width >= 480px) {
    .bc-player__cta-long {
      display: inline;
    }
  }

  /* Desktop: the large embed with artwork, and a roomier facade to match */
  @media (width >= 768px) {
    .bc-player {
      --bc-h: 120px;

      padding: 0.625rem;
    }

    .bc-player__facade {
      gap: 1rem;
      padding: 0 1.25rem 0 1rem;
    }

    .bc-player__mark {
      width: 44px;
      height: 44px;
    }

    .bc-player__mark img {
      width: 22px;
      height: 22px;
    }

    .bc-player__title {
      font-size: 1.125rem;
    }

    .bc-player__sub {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bc-player__facade,
    .bc-player__mark,
    .bc-player__cta,
    .bc-player__embed {
      transition: none;
    }

    .bc-player__facade:hover .bc-player__mark {
      transform: none;
    }
  }

  @supports not (backdrop-filter: blur(12px)) {
    .bc-player {
      background: rgb(10 10 15 / 95%);
    }
  }
</style>

<script>
  /** Must match the `width >= 768px` breakpoint that sets --bc-h above. */
  const LARGE_QUERY = "(min-width: 768px)";

  function initBandcampPlayer(): void {
    const root = document.getElementById("bandcamp-player");
    const frame = root?.querySelector<HTMLIFrameElement>(".bc-player__embed");
    if (!root || !frame) return;
    if (root.dataset.bcReady === "true") return;
    root.dataset.bcReady = "true";

    const wide = window.matchMedia(LARGE_QUERY);

    const load = (): void => {
      // The page may have been swapped by a view transition since this ran.
      if (!root.isConnected) {
        wide.removeEventListener("change", load);
        return;
      }
      const src = wide.matches ? frame.dataset.srcLarge : frame.dataset.srcSmall;
      if (!src || frame.src === src) return;
      root.classList.remove("is-loaded");
      frame.hidden = false;
      frame.src = src;
    };

    frame.addEventListener("load", () => {
      if (frame.src) root.classList.add("is-loaded");
    });

    load();
    wide.addEventListener("change", load);
  }

  initBandcampPlayer();
  // Astro view transitions swap the body; re-bind on each navigation.
  document.addEventListener("astro:page-load", initBandcampPlayer);
</script>
