---
/**
 * BandcampPlayer - the site player, streamed by Bandcamp.
 *
 * Sits in the fixed glass bar at the top of every page (the slot the old
 * audio player used) and holds Bandcamp's embedded player for the release in
 * src/data/bandcamp.ts. The embed is transparent, so the glass and the stars
 * show through it.
 *
 * Until the embed has loaded, and whenever no release ID is set, the bar
 * shows a facade: the release title and a link to Bandcamp. The facade fades
 * out the moment the embed is ready, so the bar never flashes empty.
 *
 * From 768px the large embed (120px, artwork thumbnail) is used; below that
 * the small 42px strip. The script picks the size with the same media query
 * the CSS uses, so the iframe height always matches the frame.
 *
 * Order of preference: Bandcamp's own embed; the same player relayed through
 * player.simonlowes.com (workers/bandcamp-proxy) when the browser or network
 * blocks Bandcamp's CDN and the relay's /health says the upstream is
 * answering; and finally, if src/data/tracks.ts lists self-hosted files, a
 * native player streaming those, so the music always plays. With no tracks
 * listed the facade stays, linking to Bandcamp.
 */
import {
  BANDCAMP,
  BANDCAMP_PROXY_ORIGIN,
  bandcampEmbedUrl,
  bandcampProxyEmbedUrl,
  bandcampProxyHealthUrl,
} from "../data/bandcamp";
import { SITE_TRACKS, hasSiteTracks } from "../data/tracks";

const { release, artistName } = BANDCAMP;
const hasEmbed = release.id !== "";
const hasNative = hasSiteTracks();
const hasProxy = BANDCAMP_PROXY_ORIGIN !== "";
const label = `Bandcamp player: ${release.title} by ${artistName}`;
const nativeLabel = `Site player: ${artistName}`;
---

<div
  class="bc-player"
  id="bandcamp-player"
  role="region"
  aria-label={label}
  data-has-embed={hasEmbed ? "true" : "false"}
  data-has-native={hasNative ? "true" : "false"}
  data-native-label={nativeLabel}
  data-proxy-origin={hasProxy ? BANDCAMP_PROXY_ORIGIN : undefined}
  data-proxy-health={hasProxy ? bandcampProxyHealthUrl() : undefined}
  transition:persist="player"
>
  <div class="bc-player__frame">
    <a class="bc-player__facade" href={release.url} target="_blank" rel="noopener noreferrer">
      <span class="bc-player__mark" aria-hidden="true">
        <img src="/icons/bandcamp.png" alt="" width="22" height="22" />
      </span>
      <span class="bc-player__text">
        <span class="bc-player__title">{release.title}</span>
        <span class="bc-player__sub">{artistName} · stream and buy on Bandcamp</span>
      </span>
      <span class="bc-player__cta">
        Listen<span class="bc-player__cta-long"> on Bandcamp</span>
        <span aria-hidden="true">&nearr;</span>
        <span class="sr-only"> (opens in new tab)</span>
      </span>
    </a>
    {hasEmbed && <iframe
      class="bc-player__embed"
      title={label}
      data-src-large={bandcampEmbedUrl(release, "large")}
      data-src-small={bandcampEmbedUrl(release, "small")}
      data-proxy-large={hasProxy ? bandcampProxyEmbedUrl(release, "large") : undefined}
      data-proxy-small={hasProxy ? bandcampProxyEmbedUrl(release, "small") : undefined}
      hidden
    ></iframe>}
    {hasNative && (
      <div
        class="bc-player__native"
        role="group"
        aria-label={nativeLabel}
        data-tracks={JSON.stringify(SITE_TRACKS)}
        hidden
      >
        <button class="bc-player__play" type="button" aria-label="Play" data-native="play">
          <svg class="bc-player__icon-play" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7z" fill="currentColor" />
          </svg>
          <svg class="bc-player__icon-pause" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 5h4v14H6zm8 0h4v14h-4z" fill="currentColor" />
          </svg>
        </button>
        <div class="bc-player__text">
          <span class="bc-player__title" data-native="title" aria-live="polite">
            {SITE_TRACKS[0]?.title}
          </span>
          <span class="bc-player__sub">
            {artistName}
            <span class="bc-player__native-count" data-native="count"></span>
          </span>
          <div class="bc-player__seek">
            <span class="bc-player__time" data-native="current">
              0:00
            </span>
            <input
              class="bc-player__range"
              type="range"
              min="0"
              max="0"
              value="0"
              step="1"
              aria-label="Seek"
              aria-valuetext="0:00"
              data-native="seek"
            />
            <span class="bc-player__time" data-native="duration">
              0:00
            </span>
          </div>
        </div>
        <div class="bc-player__native-actions">
          <button
            class="bc-player__skip"
            type="button"
            aria-label="Previous track"
            data-native="prev"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 6h2v12H6zm3.5 6 8.5 6V6z" fill="currentColor" />
            </svg>
          </button>
          <button class="bc-player__skip" type="button" aria-label="Next track" data-native="next">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M16 6h2v12h-2zM6 18l8.5-6L6 6z" fill="currentColor" />
            </svg>
          </button>
          <a class="bc-player__buy" href={release.url} target="_blank" rel="noopener noreferrer">
            <span class="bc-player__cta-long">Buy on </span>Bandcamp
            <span aria-hidden="true">&nearr;</span>
            <span class="sr-only"> (opens in new tab)</span>
          </a>
        </div>
        <audio preload="none" data-native="audio"></audio>
      </div>
    )}
  </div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* The glass bar: same slot, width formula and glass as the old audio player */
  .bc-player {
    --bc-h: 42px;

    position: fixed;
    top: calc(var(--edge-gap) + env(safe-area-inset-top));
    left: 50%;
    transform: translateX(-50%);
    width: calc((100% - var(--h-inset)) * var(--content-w));
    max-width: calc((1200px - var(--h-inset)) * var(--content-w));
    box-sizing: border-box;
    padding: 0.5rem;
    background: rgb(15 15 15 / 18%);
    border: 1px solid rgb(0 212 255 / 10%);
    border-radius: 12px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      0 8px 32px rgb(0 0 0 / 40%),
      0 0 40px rgb(0 212 255 / 3%),
      inset 0 1px 0 rgb(255 255 255 / 5%);
    color: #e0e0e0;
    font-family: "freight-sans-pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
    z-index: 99;
  }

  .bc-player__frame {
    position: relative;
    height: var(--bc-h);
    border-radius: 8px;
    overflow: hidden;
  }

  /* Facade: shown until the embed is ready, or for good when no ID is set */
  .bc-player__facade {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.5rem;
    color: inherit;
    text-decoration: none;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }

  .bc-player__facade:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
    border-radius: 8px;
  }

  .bc-player__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border: 1px solid rgb(0 212 255 / 20%);
    border-radius: 50%;
    background: rgb(0 212 255 / 15%);
    transition:
      background 0.2s ease,
      box-shadow 0.3s ease,
      transform 0.15s ease;
  }

  .bc-player__mark img {
    width: 18px;
    height: 18px;
  }

  .bc-player__facade:hover .bc-player__mark {
    background: rgb(0 212 255 / 25%);
    box-shadow: 0 0 20px rgb(0 212 255 / 30%);
    transform: scale(1.05);
  }

  .bc-player__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .bc-player__title {
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bc-player__sub {
    display: none;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: rgb(224 224 224 / 60%);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bc-player__cta {
    flex-shrink: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    color: rgb(224 224 224 / 85%);
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .bc-player__cta-long {
    display: none;
  }

  .bc-player__facade:hover .bc-player__cta {
    color: #00d4ff;
  }

  /* The embed: transparent, fades in over the facade once loaded */
  .bc-player__embed {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .bc-player__embed[hidden] {
    display: none;
  }

  .bc-player.is-loaded .bc-player__embed {
    opacity: 1;
  }

  /* Bandcamp's dark theme draws its own #303030 panel (transparent=true only
     clears the margin around it). Paint the frame the same grey once the
     player is up, so the bar reads as one panel rather than a box in a box. */
  .bc-player.is-loaded .bc-player__frame {
    background: #303030;
  }

  .bc-player.is-loaded .bc-player__facade {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Native fallback player: takes over the frame when the embed cannot */
  .bc-player__native {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 0.5rem;
  }

  .bc-player__native[hidden] {
    display: none;
  }

  .bc-player.is-native .bc-player__facade {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .bc-player__play,
  .bc-player__skip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0;
    color: #e0e0e0;
    background: rgb(0 212 255 / 15%);
    border: 1px solid rgb(0 212 255 / 25%);
    border-radius: 50%;
    cursor: pointer;
    transition:
      background 0.2s ease,
      box-shadow 0.3s ease,
      transform 0.15s ease;
  }

  .bc-player__play {
    width: 36px;
    height: 36px;
  }

  .bc-player__skip {
    width: 28px;
    height: 28px;
    background: transparent;
    border-color: rgb(255 255 255 / 12%);
  }

  .bc-player__play svg,
  .bc-player__skip svg {
    width: 18px;
    height: 18px;
  }

  .bc-player__skip svg {
    width: 16px;
    height: 16px;
  }

  .bc-player__play:hover,
  .bc-player__skip:hover {
    background: rgb(0 212 255 / 25%);
    box-shadow: 0 0 20px rgb(0 212 255 / 30%);
    transform: scale(1.05);
  }

  .bc-player__play:focus-visible,
  .bc-player__skip:focus-visible,
  .bc-player__buy:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .bc-player__range:focus-visible {
    outline: none;
  }

  .bc-player__range:focus-visible::-webkit-slider-thumb {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .bc-player__range:focus-visible::-moz-range-thumb {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .bc-player__icon-pause {
    display: none;
  }

  .bc-player.is-playing .bc-player__icon-pause {
    display: block;
  }

  .bc-player.is-playing .bc-player__icon-play {
    display: none;
  }

  .bc-player__native-count {
    margin-left: 0.25rem;
  }

  .bc-player__seek {
    display: none;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .bc-player__time {
    flex-shrink: 0;
    min-width: 2.5rem;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: rgb(224 224 224 / 60%);
  }

  .bc-player__time:last-child {
    text-align: right;
  }

  .bc-player__range {
    flex: 1;
    height: 4px;
    margin: 0;
    appearance: none;
    background: linear-gradient(
      to right,
      #00d4ff 0%,
      #00d4ff var(--bc-progress, 0%),
      rgb(255 255 255 / 15%) var(--bc-progress, 0%),
      rgb(255 255 255 / 15%) 100%
    );
    border-radius: 2px;
    cursor: pointer;
  }

  .bc-player__range::-webkit-slider-thumb {
    width: 12px;
    height: 12px;
    appearance: none;
    background: #fff;
    border: 0;
    border-radius: 50%;
    box-shadow: 0 0 8px rgb(0 212 255 / 60%);
  }

  .bc-player__range::-moz-range-thumb {
    width: 12px;
    height: 12px;
    background: #fff;
    border: 0;
    border-radius: 50%;
    box-shadow: 0 0 8px rgb(0 212 255 / 60%);
  }

  .bc-player__native-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .bc-player__skip {
    display: none;
  }

  .bc-player.has-many-tracks .bc-player__skip {
    display: flex;
  }

  .bc-player__buy {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    color: rgb(224 224 224 / 85%);
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .bc-player__buy:hover {
    color: #00d4ff;
  }

  @media (width >= 480px) {
    .bc-player__cta-long {
      display: inline;
    }
  }

  /* Desktop: the large embed with artwork, and a roomier facade to match */
  @media (width >= 768px) {
    .bc-player {
      --bc-h: 120px;

      padding: 0.625rem;
    }

    .bc-player__facade {
      gap: 1rem;
      padding: 0 1.25rem 0 1rem;
    }

    .bc-player__mark {
      width: 44px;
      height: 44px;
    }

    .bc-player__mark img {
      width: 22px;
      height: 22px;
    }

    .bc-player__title {
      font-size: 1.125rem;
    }

    .bc-player__sub {
      display: block;
    }

    /* Bandcamp's large player stops at 700px; keep it centred in a wider bar */
    .bc-player__embed {
      max-width: 700px;
      margin: 0 auto;
    }

    .bc-player__native {
      gap: 1rem;
      padding: 0 1.25rem 0 1rem;
    }

    .bc-player__play {
      width: 44px;
      height: 44px;
    }

    .bc-player__play svg {
      width: 22px;
      height: 22px;
    }

    .bc-player__seek {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bc-player__facade,
    .bc-player__mark,
    .bc-player__cta,
    .bc-player__embed,
    .bc-player__play,
    .bc-player__skip,
    .bc-player__buy {
      transition: none;
    }

    .bc-player__facade:hover .bc-player__mark,
    .bc-player__play:hover,
    .bc-player__skip:hover {
      transform: none;
    }
  }

  @supports not (backdrop-filter: blur(12px)) {
    .bc-player {
      background: rgb(10 10 15 / 95%);
    }
  }
</style>

<script>
  import { formatTime } from "../data/tracks";
  import type { SiteTrack } from "../data/tracks";

  /** Must match the `width >= 768px` breakpoint that sets --bc-h above. */
  const LARGE_QUERY = "(min-width: 768px)";

  /**
   * Bandcamp's player is HTML from bandcamp.com whose script, styles and
   * artwork come from its CDN, bcbits.com. Blockers and DNS filters often
   * allow the first and block the second, which leaves a blank iframe that
   * still fires `load`. Both must answer before the embed is even requested.
   */
  const BCBITS_PROBE = "https://s4.bcbits.com/img/bclogo.png";
  /**
   * How long the embed gets, after its HTML has loaded, to report ready
   * before the fallback is shown. The embed keeps loading behind the
   * fallback; if it reports ready later and nothing is playing, it takes
   * over again, so a slow connection never loses Bandcamp for good.
   */
  const EMBED_GRACE_MS = 10000;
  /**
   * Bandcamp's embedded player posts "playerinited" to its parent once it has
   * rendered. That, not the iframe's `load` event (which fires for a blank
   * page too), is what proves the player is really there.
   */
  const BANDCAMP_ORIGIN = "https://bandcamp.com";
  const READY_MESSAGE = "playerinited";

  const probe = (url: string): Promise<void> =>
    fetch(url, { method: "HEAD", mode: "no-cors", credentials: "omit", cache: "no-store" }).then(
      () => undefined
    );

  interface NativePlayer {
    /** Reveal the native player (loads the first track on first call). */
    show: () => void;
    /** Hide it again, only when nothing is playing. Returns whether it did. */
    hideIfIdle: () => boolean;
  }

  // ---------------------------------------------------------------------
  // Native fallback player
  // ---------------------------------------------------------------------
  function initNativePlayer(root: HTMLElement, native: HTMLElement): NativePlayer | null {
    let tracks: SiteTrack[] = [];
    try {
      tracks = JSON.parse(native.dataset.tracks ?? "[]") as SiteTrack[];
    } catch {
      tracks = [];
    }
    if (tracks.length === 0) return null;

    const q = <T extends Element>(name: string): T | null =>
      native.querySelector<T>(`[data-native="${name}"]`);
    const audio = q<HTMLAudioElement>("audio");
    const play = q<HTMLButtonElement>("play");
    const prev = q<HTMLButtonElement>("prev");
    const next = q<HTMLButtonElement>("next");
    const seek = q<HTMLInputElement>("seek");
    const title = q<HTMLElement>("title");
    const count = q<HTMLElement>("count");
    const current = q<HTMLElement>("current");
    const duration = q<HTMLElement>("duration");
    if (!audio || !play || !seek || !title) return null;

    let index = 0;
    let seeking = false;
    let started = false;
    const embedLabel = root.getAttribute("aria-label") ?? "";
    const nativeLabel = root.dataset.nativeLabel ?? "Site player";
    if (tracks.length > 1) root.classList.add("has-many-tracks");

    const setSeek = (position: number, total: number): void => {
      const ok = Number.isFinite(total) && total > 0;
      seek.max = ok ? String(Math.floor(total)) : "0";
      seek.value = ok ? String(Math.floor(position)) : "0";
      const pct = ok ? Math.max(0, Math.min(100, (position / total) * 100)) : 0;
      seek.style.setProperty("--bc-progress", `${pct}%`);
      seek.setAttribute(
        "aria-valuetext",
        ok ? `${formatTime(position)} of ${formatTime(total)}` : formatTime(position)
      );
      if (current) current.textContent = formatTime(position);
      if (duration) duration.textContent = formatTime(total);
    };

    const setMediaSession = (track: SiteTrack): void => {
      if (!("mediaSession" in navigator) || typeof MediaMetadata !== "function") return;
      try {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: track.title,
          artist: "Simon Lowes",
        });
      } catch {
        /* optional */
      }
    };

    const loadTrack = (i: number, autoplay: boolean): void => {
      index = (i + tracks.length) % tracks.length;
      const track = tracks[index];
      if (!track) return;
      audio.src = track.src;
      title.textContent = track.title;
      if (count) count.textContent = tracks.length > 1 ? `· ${index + 1}/${tracks.length}` : "";
      setSeek(0, track.duration ?? NaN);
      setMediaSession(track);
      if (autoplay) void audio.play().catch(() => undefined);
    };

    const toggle = (): void => {
      if (audio.paused) void audio.play().catch(() => undefined);
      else audio.pause();
    };

    play.addEventListener("click", toggle);
    prev?.addEventListener("click", () => loadTrack(index - 1, !audio.paused));
    next?.addEventListener("click", () => loadTrack(index + 1, !audio.paused));
    audio.addEventListener("play", () => {
      root.classList.add("is-playing");
      play.setAttribute("aria-label", "Pause");
    });
    audio.addEventListener("pause", () => {
      root.classList.remove("is-playing");
      play.setAttribute("aria-label", "Play");
    });
    audio.addEventListener("ended", () => {
      if (tracks.length > 1) loadTrack(index + 1, true);
      else setSeek(0, audio.duration);
    });
    audio.addEventListener("loadedmetadata", () => setSeek(audio.currentTime, audio.duration));
    audio.addEventListener("timeupdate", () => {
      if (!seeking) setSeek(audio.currentTime, audio.duration);
    });
    seek.addEventListener("input", () => {
      seeking = true;
      const position = Number(seek.value);
      const total = Number(seek.max);
      seek.style.setProperty("--bc-progress", `${total > 0 ? (position / total) * 100 : 0}%`);
      seek.setAttribute("aria-valuetext", `${formatTime(position)} of ${formatTime(total)}`);
      if (current) current.textContent = formatTime(position);
    });
    seek.addEventListener("change", () => {
      seeking = false;
      if (Number.isFinite(audio.duration)) audio.currentTime = Number(seek.value);
    });

    const registerMediaSessionActions = (): void => {
      if (!("mediaSession" in navigator)) return;
      const actions: [MediaSessionAction, () => void][] = [
        ["play", () => void audio.play().catch(() => undefined)],
        ["pause", () => audio.pause()],
      ];
      if (tracks.length > 1) {
        actions.push(["previoustrack", () => loadTrack(index - 1, true)]);
        actions.push(["nexttrack", () => loadTrack(index + 1, true)]);
      }
      for (const [action, handler] of actions) {
        try {
          navigator.mediaSession.setActionHandler(action, handler);
        } catch {
          /* unsupported action */
        }
      }
    };

    return {
      show: () => {
        if (!started) {
          // Nothing is fetched and no OS media controls are claimed until the
          // fallback is really needed
          started = true;
          loadTrack(0, false);
          registerMediaSessionActions();
        }
        native.hidden = false;
        root.classList.add("is-native");
        root.classList.remove("is-loaded");
        root.setAttribute("aria-label", nativeLabel);
      },
      hideIfIdle: () => {
        if (!audio.paused) return false;
        native.hidden = true;
        root.classList.remove("is-native");
        root.setAttribute("aria-label", embedLabel);
        return true;
      },
    };
  }

  // ---------------------------------------------------------------------
  // Mode selection: embed if it will really render, else native, else facade
  // ---------------------------------------------------------------------
  function initBandcampPlayer(): void {
    const root = document.getElementById("bandcamp-player");
    if (!root) return;
    // With transition:persist the element, its iframe and its audio survive
    // navigation, so this runs once per element
    if (root.dataset.bcReady === "true") return;
    root.dataset.bcReady = "true";

    const frame = root.querySelector<HTMLIFrameElement>(".bc-player__embed");
    const nativeEl = root.querySelector<HTMLElement>(".bc-player__native");
    let native: NativePlayer | null = null;
    try {
      native = nativeEl ? initNativePlayer(root, nativeEl) : null;
    } catch {
      // A fallback-only failure must never take the Bandcamp path down
      native = null;
    }

    if (!frame) {
      // No release ID configured: native player if there are tracks, else facade
      native?.show();
      return;
    }

    const wide = window.matchMedia(LARGE_QUERY);
    let graceTimer: number | undefined;
    /** The src currently requested; a ready message for anything else is stale. */
    let currentSrc = "";
    /** Which host the player is being loaded from. */
    type Source = "bandcamp" | "proxy";
    let source: Source = "bandcamp";
    let proxyTried = false;
    const proxyOrigin = root.dataset.proxyOrigin ?? "";
    const proxyHealth = root.dataset.proxyHealth ?? "";
    const allowedOrigins = new Set([BANDCAMP_ORIGIN, proxyOrigin].filter(Boolean));

    const wantedSrc = (from: Source = source): string | undefined => {
      if (from === "proxy")
        return wide.matches ? frame.dataset.proxyLarge : frame.dataset.proxySmall;
      return wide.matches ? frame.dataset.srcLarge : frame.dataset.srcSmall;
    };

    const setSrc = (from: Source): void => {
      const src = wantedSrc(from);
      if (!src || !root.isConnected) return;
      source = from;
      currentSrc = src;
      root.classList.remove("is-loaded");
      // Keep the fallback visible (if it is) until the player reports ready
      if (!root.classList.contains("is-native")) frame.hidden = false;
      frame.src = src;
      armGrace();
    };

    /**
     * Bandcamp's own host failed or went quiet: ask the first-party relay
     * whether Bandcamp is answering it with a real player, and use that.
     */
    const tryProxy = (): void => {
      if (proxyTried || !proxyOrigin || !proxyHealth || !frame.dataset.proxyLarge) {
        showFallback();
        return;
      }
      proxyTried = true;
      fetch(proxyHealth, { mode: "cors", credentials: "omit", cache: "no-store" })
        .then((response) => (response.ok ? response.json() : Promise.reject(new Error("health"))))
        .then((health: { ok?: boolean }) => {
          if (!root.isConnected) return;
          if (health.ok) setSrc("proxy");
          else showFallback();
        })
        .catch(showFallback);
    };

    const armGrace = (): void => {
      window.clearTimeout(graceTimer);
      graceTimer = window.setTimeout(() => {
        if (root.classList.contains("is-loaded")) return;
        // The official embed loaded its HTML but its player never started
        // (CDN blocked): try the relay before giving up on Bandcamp
        if (source === "bandcamp") tryProxy();
        else showFallback();
      }, EMBED_GRACE_MS);
    };

    const showFallback = (): void => {
      if (!root.isConnected) return;
      root.classList.remove("is-loaded");
      frame.hidden = true;
      if (native) native.show();
      /* otherwise the facade stays: it links to the release on Bandcamp */
    };

    const teardown = (): void => {
      window.clearTimeout(graceTimer);
      window.removeEventListener("message", onMessage);
      wide.removeEventListener("change", load);
    };

    const onMessage = (event: MessageEvent): void => {
      if (!root.isConnected) {
        teardown();
        return;
      }
      if (!allowedOrigins.has(event.origin) || event.source !== frame.contentWindow) return;
      const data: unknown = event.data;
      const ready =
        data === READY_MESSAGE ||
        (typeof data === "object" &&
          data !== null &&
          (data as { data?: unknown }).data === READY_MESSAGE);
      if (!ready || !frame.src || frame.src !== currentSrc) return;
      window.clearTimeout(graceTimer);
      // The fallback may already be up (slow connection); take over only if
      // the visitor is not listening to it
      if (root.classList.contains("is-native") && !(native && native.hideIfIdle())) return;
      frame.hidden = false;
      root.classList.add("is-loaded");
    };
    window.addEventListener("message", onMessage);

    frame.addEventListener("load", () => {
      // The player script usually reports ready before `load` (which waits for
      // artwork and styles); if it has not yet, give it a fresh grace period
      // from here so slow HTML and a slow script are each tolerated.
      if (frame.src && !root.classList.contains("is-loaded")) armGrace();
    });

    const load = (): void => {
      // The page may have been swapped by a view transition since this ran.
      if (!root.isConnected) {
        teardown();
        return;
      }
      const src = wantedSrc();
      if (!src || frame.src === src) return;
      if (source === "proxy") {
        // Already on the relay (size switch): no probing needed
        setSrc("proxy");
        return;
      }
      // Bandcamp's page and its CDN must both answer; a blocked CDN leaves a
      // blank player that still fires `load`.
      Promise.all([probe(src), probe(BCBITS_PROBE)])
        .then(() => {
          // The viewport may have crossed the breakpoint again meanwhile
          if (!root.isConnected || wantedSrc("bandcamp") !== src || frame.src === src) return;
          setSrc("bandcamp");
        })
        .catch(() => {
          frame.removeAttribute("src");
          tryProxy();
        });
    };

    load();
    wide.addEventListener("change", load);
  }

  initBandcampPlayer();
  // Astro view transitions swap the body; re-bind on each navigation (a
  // persisted bar is skipped by the bcReady guard, a fresh one is set up).
  document.addEventListener("astro:page-load", initBandcampPlayer);
</script>
