# Security Headers Reference
# NOT automatically applied — this file is only parsed by Cloudflare Pages / Netlify.
# Site is hosted on Dokploy VPS behind Cloudflare proxy (orange cloud).
# To apply: set these via Cloudflare Transform Rules (Response Headers) or
# Traefik middleware labels in Dokploy.
#
# As of September 2026 the live site sends only:
#   content-security-policy: frame-ancestors 'none'
#   x-frame-options: DENY, permissions-policy, referrer-policy
# so the Bandcamp iframe in the top bar is not restricted. If the full CSP
# below is ever applied, keep frame-src https://bandcamp.com in it.

/*
  # Prevent clickjacking attacks
  X-Frame-Options: DENY

  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Control referrer information
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions Policy (formerly Feature Policy)
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # Content Security Policy
  # - 'unsafe-inline' for scripts: required by Astro View Transitions and inline <script> tags
  # - 'unsafe-inline' for styles: required by inline <style> blocks in Astro components
  # - connect-src https://bandcamp.com https://s4.bcbits.com: the player probes both
  #   (HEAD, no-cors) before showing the embed; without them the site would
  #   always show the native fallback player
  # - media-src: the fallback player's self-hosted audio (add the R2 host if tracks move there)
  # - frame-src https://bandcamp.com: the embedded Bandcamp player in the top bar
  # - worker-src 'self': PWA service worker
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://bandcamp.com https://s4.bcbits.com; media-src 'self' https://media.simonlowes.com; worker-src 'self'; frame-src https://bandcamp.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Cache static assets for 1 year
/favicons/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/JS/*
  Cache-Control: public, max-age=31536000, immutable
