{
  "name": "simonlowes",
  "version": "1.0.0",
  "description": "https://simonlowes.com",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.4",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/ui": "^5.0.1",
    "astro": "^7.3.4",
    "axe-core": "^4.13.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.2.1",
    "happy-dom": "^20.12.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "simple-icons": "^16.33.0",
    "slate": "^0.126.2",
    "slate-dom": "^0.126.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@vite-pwa/astro": "^1.2.0",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "diff": "^8.0.3",
    "brace-expansion": "^5.0.9",
    "esbuild": "^0.25.0",
    "serialize-javascript": "^7.0.3",
    "fast-xml-parser": "^5.5.7",
    "flatted": "^3.4.2",
    "lodash": "^4.18.1",
    "nanoid@3": "^3.3.17",
    "nanoid@5": "^5.1.16",
    "js-yaml@3": "^3.15.1",
    "js-yaml@4": "^4.3.1",
    "@vite-pwa/astro": {
      "astro": "$astro"
    }
  }
}
